+		}
+
+		// Allow to quit the game anywhere
+		if ((ff8_get_key_state(DIK_LCONTROL) || ff8_get_key_state(DIK_RCONTROL)) && ff8_get_key_state(DIK_Q))
+		{
+			if (is_q_pressed > 20)
+			{
+				((ff8_game_obj *)common_externals.get_game_object())->do_quit = 1;
+				is_q_pressed = 0;
+			}
+			else
+			{
+				is_q_pressed += 1;
+			}
+		}
+		else
+		{
+			is_q_pressed = 0;
+		}
+	}
+
+	return 0;
