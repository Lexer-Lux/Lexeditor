+	group_counter = 0;
+
+	while(group_counter < polygon_set->numgroups)
+	{
+		uint32_t defer = false;
+		uint32_t zsort = false;
+
+		if(polygon_set->per_group_hundreds) hundred_data = polygon_set->hundred_data_group_array[group_counter];
