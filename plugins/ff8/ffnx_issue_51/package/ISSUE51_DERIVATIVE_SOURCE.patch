+$identity = "Lexeditor issue 51 shared magic core; base=c056db2783f376a340fcefa6a48cc33618998876; runtime=on; hooks=28"
+$configIdentity = "Lexeditor issue 51 config: <basedir>/<direct_mode_path>/lexeditor/gameplay.toml; schemaVersion=1; sharedMagicInventory=bool; magicStockLimit=int[1,255]; missing=false; invalid=false; unknown=false"
