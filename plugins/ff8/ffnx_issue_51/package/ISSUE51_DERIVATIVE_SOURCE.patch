+{
+    return 1U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_compiled_hook_count()
+{
+    return kCompleteHookCount;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_compiled_call_site_count()
+{
+    return 4U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_compiled_patch_site_count()
+{
+    return 32U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned long long
+lexeditor_ff8_shared_magic_function_hit_count(const unsigned int index)
+{
+    return index < g_function_hits.size() ? g_function_hits[index] : 0ULL;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned long long
+lexeditor_ff8_shared_magic_call_site_hit_count(const unsigned int index)
+{
+    return index < g_call_site_hits.size() ? g_call_site_hits[index] : 0ULL;
+}
