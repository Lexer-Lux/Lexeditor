+
+# Blue junctioned-GF HP bar above each party name.
+enable_ff8_gf_hp_bars = false
+
+# Show the computer local clock on FF8 main menu without changing PLAY time.
+enable_ff8_ingame_time = false
+
 # Set hotkey to toggle the DevTools window.
