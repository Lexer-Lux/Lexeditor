+void *driver_realloc(void *ptr, uint32_t size)
+{
+	void *tmp = realloc(ptr, size);
+	ffnx_trace("%i: realloc(0x%x, %i) = 0x%x\n", allocs, ptr, size, tmp);
+	return tmp;
+}
