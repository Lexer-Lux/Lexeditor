+void ff8_shared_magic_heartbeat()
+{
+    // Nothing to drain here any more: the message box owns the queue,
+    // holds each sentence long enough to read, and draws it the way FF8
+    // draws its own. FFNx's popup fades on a decay tuned for one word.
+
+    // The loader has returned. Use the renderer overlay, never the menu controller.
+    if (!g_activation_toast.empty() && get_popup_time() == 0) {
+        show_popup_msg(TEXTCOLOR_RED, "%s", g_activation_toast.c_str());
+        g_activation_toast.clear();
+    }
+    if (!g_requested && !g_installed && !g_install_failed &&
+        g_heartbeat_sequence != 0) {
+        return;
+    }
+    const ULONGLONG now = GetTickCount64();
+    if (g_last_heartbeat_tick != 0 && now - g_last_heartbeat_tick < 10000ULL) {
+        return;
+    }
+    g_last_heartbeat_tick = now;
+    log_launch_once();
+    unsigned int actor_mask = 0;
+    for (std::size_t actor = 0; actor < g_actor_ready.size(); ++actor) {
+        actor_mask |= g_actor_ready[actor] ? (1U << actor) : 0U;
+    }
+    char line[8192]{};
+    int used = std::snprintf(line, sizeof(line),
+        "heartbeat seq=%llu requested=%u installedFunctions=%u installedCalls=%u "
+        "active=%u phase=%s warning=%s actorMask=%u activation=%llu/%llu "
+        "reconcile=%llu/%llu save=%llu/%llu firstFailure=%s functionHits=",
+        static_cast<unsigned long long>(++g_heartbeat_sequence),
+        g_requested ? 1U : 0U, g_installed ? 28U : 0U,
+        g_installed ? 4U : 0U, g_state.shared_pool_active ? 1U : 0U,
+        phase_name(), warning_name(), actor_mask,
+        static_cast<unsigned long long>(g_activation_successes),
+        static_cast<unsigned long long>(g_activation_attempts),
+        static_cast<unsigned long long>(g_reconcile_successes),
+        static_cast<unsigned long long>(g_reconcile_attempts),
+        static_cast<unsigned long long>(g_save_successes),
+        static_cast<unsigned long long>(g_save_attempts),
+        g_first_failure.empty() ? "none" : g_first_failure.c_str());
+    for (std::size_t index = 0; index < g_function_hits.size() &&
+         used > 0 && static_cast<std::size_t>(used) < sizeof(line); ++index) {
+        used += std::snprintf(line + used, sizeof(line) - used, "%s%llu",
+            index == 0 ? "" : ",",
+            static_cast<unsigned long long>(g_function_hits[index]));
+    }
+    if (used > 0 && static_cast<std::size_t>(used) < sizeof(line)) {
+        used += std::snprintf(line + used, sizeof(line) - used, " callHits=");
+    }
+    for (std::size_t index = 0; index < g_call_site_hits.size() &&
+         used > 0 && static_cast<std::size_t>(used) < sizeof(line); ++index) {
+        used += std::snprintf(line + used, sizeof(line) - used, "%s%llu",
+            index == 0 ? "" : ",",
+            static_cast<unsigned long long>(g_call_site_hits[index]));
+    }
+    if (used > 0 && static_cast<std::size_t>(used) + 1 < sizeof(line)) {
+        line[used++] = '\n';
+        line[used] = '\0';
+    }
+    append_runtime_log(line);
+}
+
+void ff8_shared_magic_set_config_path(const char *path)
+{
+    g_config_path = path == nullptr ? "<not-resolved>" : path;
+    log_launch_once();
+}
+
+void ff8_shared_magic_set_requested(const bool requested)
+{
+    // Registration is one-shot. Changing this after ff8_init_hooks() cannot
+    // create a partial runtime state.
+    if (!g_installed && !g_install_failed) {
+        g_requested = requested;
+    }
+}
+
+void ff8_shared_magic_set_stock_limit(const unsigned char stock_limit)
+{
+    if (!g_installed && !g_install_failed) {
+        g_stock_limit = stock_limit == 0 ? kDefaultStockLimit : stock_limit;
+    }
+}
+
+bool ff8_shared_magic_init()
+{
+    if (!g_requested) {
+        append_runtime_log("init requested=0 installedFunctions=0 installedCalls=0\n");
+        ffnx_info("Shared Magic: disabled; installed zero hooks.\n");
+        return false;
+    }
+    if (g_installed || g_install_failed) {
+        return g_installed;
+    }
+    populate_hooks();
+    if (!FF8_US_VERSION || !executable_hash_matches() ||
+        !verify_hook_guards() || !verify_auxiliary_guards() ||
+        !prepare_hook_code()) {
+        g_install_failed = true;
+        if (g_first_failure.empty()) g_first_failure = "preflight failed";
+        append_runtime_log("failure reason=preflight-failed installedFunctions=0 installedCalls=0\n");
+        ffnx_error("Shared Magic: preflight failed; installed zero hooks.\n");
+        return false;
+    }
+
+    if (!install_hooks()) {
+        g_install_failed = true;
+        if (g_first_failure.empty()) g_first_failure = "transactional install failed";
+        append_runtime_log("failure reason=transactional-install-failed installedFunctions=0 installedCalls=0\n");
+        ffnx_error("Shared Magic: transactional install failed; hooks rolled back.\n");
+        return false;
+    }
+    g_installed = true;
+    append_runtime_log("init requested=1 installedFunctions=28 installedCalls=4\n");
+    ffnx_info("Shared Magic: installed the complete guarded hook set.\n");
+    return true;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) const char *
+lexeditor_ff8_shared_magic_runtime_identity()
+{
+    return kRuntimeIdentity;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_requested()
+{
+    return g_requested ? 1U : 0U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_complete_hook_count()
+{
+    return g_installed ? kCompleteHookCount : 0U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_complete_call_site_count()
+{
+    return g_installed ? 4U : 0U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_complete_patch_site_count()
+{
+    return g_installed ? 32U : 0U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_active()
+{
+    return g_state.shared_pool_active ? 1U : 0U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
+lexeditor_ff8_shared_magic_compile_gate()
+{
+    return 1U;
+}
+
+extern "C" __declspec(dllexport) __declspec(noinline) unsigned int
