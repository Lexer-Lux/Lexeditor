+void *driver_calloc(uint32_t size, uint32_t num)
+{
+	void *tmp = calloc(size, num);
+	ffnx_trace("%i: calloc(%i, %i) = 0x%x\n", ++allocs, size, num, tmp);
+	return tmp;
+}
+
+void driver_free(void *ptr)
+{
+	if(!ptr) return;
+
+	ffnx_trace("%i: free(0x%x)\n", --allocs, ptr);
+	free(ptr);
+}
