+bool guard(const std::uint32_t address,
+           std::initializer_list<std::uint8_t> expected,
+           const char *name)
+{
+    if (address == 0 ||
+        std::memcmp(reinterpret_cast<const void *>(address), expected.begin(),
+                    expected.size()) != 0) {
+        ffnx_error("Shared Magic: byte guard failed for %s at %08X.\n",
+                   name, address);
+        return false;
+    }
+    return true;
