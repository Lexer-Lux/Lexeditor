+bool path_below(const std::filesystem::path &child, const std::filesystem::path &parent)
+{
+    auto child_it = child.begin();
+    for (auto parent_it = parent.begin(); parent_it != parent.end(); ++parent_it, ++child_it) {
+        if (child_it == child.end() || lower_ascii(child_it->string()) != lower_ascii(parent_it->string())) return false;
+    }
+    return true;
+}
