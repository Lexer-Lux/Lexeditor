+namespace {
+using CameraUpdate = std::uint32_t(__cdecl *)(void *, void *, void *, void *);
+using BattleCameraUpdate = void(__cdecl *)();
+CameraUpdate original_update = nullptr;
+BattleCameraUpdate original_battle_update = nullptr;
