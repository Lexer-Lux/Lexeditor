+		ff7_handle_ambient_playback();
+		ff7_handle_voice_playback();
+		ff7_handle_wmode_reset();
+		ff7::field::ff7_handle_KAWAI_reset();
+	}
+
+	// Steamworks SDK API run callbacks
+	if(enable_steam_achievements)
+		SteamAPI_RunCallbacks();
+
