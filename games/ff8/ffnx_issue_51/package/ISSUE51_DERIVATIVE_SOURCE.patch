+void __cdecl load_copy_and_activate(void *source, void *destination,
+                                    const std::size_t size)
+{
+    record_call_site_hit(0);
+    auto original = reinterpret_cast<void (__cdecl *)(void *, void *, std::size_t)>(
+        ff8_externals.shared_magic_save_map_copy);
+    original(source, destination, size);
+    request_activation();
+}
+
+void __cdecl new_game_setup_and_activate()
+{
+    record_call_site_hit(1);
+    auto original = reinterpret_cast<void (__cdecl *)()>(
+        ff8_externals.shared_magic_new_game_setup);
+    original();
+    request_activation();
+}
+
+int __cdecl serializer_guarded_impl(const int slot, void *buffer)
+{
+    ++g_save_attempts;
+    auto original = reinterpret_cast<int (__cdecl *)(int, void *)>(
+        ff8_externals.shared_magic_serializer);
+    if (!g_state.shared_pool_active) {
+        return original(slot, buffer);
+    }
+    if (g_state.phase == RuntimePhase::scenario_private) {
+        ffnx_warning("Shared Magic: refused a save during a private scenario.\n");
+        return 0;
+    }
+    if (g_state.phase != RuntimePhase::shared_mirror) {
+        fail_closed_to_canonical("serializer entered an invalid runtime phase");
+        return 0;
+    }
+
+    PrivateInventories canonical = read_saved();
+    if (!begin_canonical_save(g_state, canonical)) {
+        fail_closed_to_canonical("serializer canonicalization failed");
+        return 0;
+    }
+    if (g_state.phase != RuntimePhase::save_canonical) {
+        fail_closed_to_canonical("serializer did not enter canonical phase");
+        return 0;
+    }
+    write_saved(canonical);
+    const int result = original(slot, buffer);
+
+    PrivateInventories restored = read_saved();
+    if (!finish_canonical_save(g_state, restored)) {
+        fail_closed_to_canonical("serializer mirror restore failed");
+        return 0;
+    }
+    write_saved(restored);
+    mirror_actors();
+    ++g_save_successes;
+    return result;
+}
+
+int __cdecl serializer_guarded_call_1(const int slot, void *buffer)
+{
+    record_call_site_hit(2);
+    return serializer_guarded_impl(slot, buffer);
+}
+
+int __cdecl serializer_guarded_call_2(const int slot, void *buffer)
+{
+    record_call_site_hit(3);
+    return serializer_guarded_impl(slot, buffer);
+}
+
+constexpr std::size_t kCallPatchCount = 4;
+constexpr std::size_t kPatchSiteCount = kCompleteHookCount + kCallPatchCount;
+
+struct PatchSite {
+    std::uint8_t *address = nullptr;
+    std::uint8_t length = 0;
+    const char *name = nullptr;
+    std::array<std::uint8_t, 16> original{};
+    std::array<std::uint8_t, 16> replacement{};
+};
+
+bool write_site_relative(PatchSite &site, const std::uint8_t opcode,
+                         const void *target)
+{
+    const auto next = reinterpret_cast<std::intptr_t>(site.address + 5);
+    const auto destination = reinterpret_cast<std::intptr_t>(target);
+    const auto displacement = destination - next;
+    if (displacement < std::numeric_limits<std::int32_t>::min() ||
+        displacement > std::numeric_limits<std::int32_t>::max()) {
+        return false;
+    }
+    site.replacement[0] = opcode;
+    *reinterpret_cast<std::int32_t *>(site.replacement.data() + 1) =
+        static_cast<std::int32_t>(displacement);
+    return true;
+}
+
+struct PatchPage {
+    std::uint8_t *base = nullptr;
+    SIZE_T size = 0;
+    DWORD original_protection = 0;
+    bool writable = false;
+};
+
+constexpr std::size_t kMaxPatchPages = kPatchSiteCount * 2;
+
+bool set_pages_writable(std::array<PatchPage, kMaxPatchPages> &pages,
+                        const std::size_t count)
+{
+    for (std::size_t index = 0; index < count; ++index) {
+        DWORD previous = 0;
+        if (!VirtualProtect(pages[index].base, pages[index].size,
+                            PAGE_EXECUTE_READWRITE, &previous)) {
+            return false;
+        }
+        if (!pages[index].writable) {
+            pages[index].original_protection = previous;
+        }
+        pages[index].writable = true;
+    }
+    return true;
+}
+
+bool restore_page_protections(std::array<PatchPage, kMaxPatchPages> &pages,
+                              const std::size_t count)
+{
+    bool complete = true;
+    for (std::size_t index = 0; index < count; ++index) {
+        if (!pages[index].writable) {
+            continue;
+        }
+        DWORD ignored = 0;
+        const bool restored = VirtualProtect(
+            pages[index].base, pages[index].size,
+            pages[index].original_protection, &ignored) != 0;
+        pages[index].writable = !restored;
+        complete = restored && complete;
+    }
+    return complete;
+}
+
+[[noreturn]] void hard_stop_unproved_patch_state(const char *reason)
+{
+    if (g_first_failure.empty()) {
+        g_first_failure = reason;
+    }
+    char line[512]{};
+    std::snprintf(line, sizeof(line),
+                  "FATAL reason=%s win32=%lu action=terminate-before-game-startup\n",
+                  reason, GetLastError());
+    append_runtime_log(line);
+    TerminateProcess(GetCurrentProcess(), ERROR_INVALID_STATE);
+    std::abort();
+}
+
+bool rollback_patches(const std::array<PatchSite, kPatchSiteCount> &sites,
+                      std::array<PatchPage, kMaxPatchPages> &pages,
+                      const std::size_t page_count)
+{
+    if (!set_pages_writable(pages, page_count)) {
+        return false;
+    }
+    bool restored = true;
+    for (const PatchSite &site : sites) {
+        std::memcpy(site.address, site.original.data(), site.length);
+    }
+    restored = FlushInstructionCache(GetCurrentProcess(), nullptr, 0) != 0 &&
+        restored;
+    for (const PatchSite &site : sites) {
+        restored =
+            std::memcmp(site.address, site.original.data(), site.length) == 0 &&
+            restored;
+    }
+    restored = restore_page_protections(pages, page_count) && restored;
+    return restored;
+}
+
+bool install_hooks()
+{
+    std::array<PatchSite, kPatchSiteCount> sites{};
+    std::size_t next = 0;
+    for (const HookSpec &hook : g_hooks) {
+        PatchSite &site = sites[next++];
+        site.address = reinterpret_cast<std::uint8_t *>(*hook.address);
+        site.length = hook.patch_length;
+        site.name = hook.name;
+        std::memcpy(site.original.data(), site.address, site.length);
+        site.replacement = site.original;
+        if (!write_site_relative(site, 0xE9, hook.stub)) {
+            return false;
+        }
+        if (site.length > 5) {
+            std::memset(site.replacement.data() + 5, 0x90, site.length - 5);
+        }
+    }
+
+    const std::array<std::pair<std::uint32_t, void *>, kCallPatchCount> calls = {{
+        {ff8_externals.shared_magic_load_copy_call,
+         reinterpret_cast<void *>(&load_copy_and_activate)},
+        {ff8_externals.shared_magic_new_game_setup_call,
+         reinterpret_cast<void *>(&new_game_setup_and_activate)},
+        {ff8_externals.shared_magic_serializer_call_1,
+         reinterpret_cast<void *>(&serializer_guarded_call_1)},
+        {ff8_externals.shared_magic_serializer_call_2,
+         reinterpret_cast<void *>(&serializer_guarded_call_2)},
+    }};
+    for (const auto &[address, replacement] : calls) {
+        PatchSite &site = sites[next++];
+        site.address = reinterpret_cast<std::uint8_t *>(address);
+        site.length = 5;
+        site.name = "call-site replacement";
+        std::memcpy(site.original.data(), site.address, site.length);
+        site.replacement = site.original;
+        if (!write_site_relative(site, 0xE8, replacement)) {
+            return false;
+        }
+    }
+    if (next != sites.size()) {
+        ffnx_error("Shared Magic: patch plan is incomplete.\n");
+        return false;
+    }
+
+    for (std::size_t left = 0; left < sites.size(); ++left) {
+        const auto left_begin = reinterpret_cast<std::uintptr_t>(sites[left].address);
+        const auto left_end = left_begin + sites[left].length;
+        for (std::size_t right = left + 1; right < sites.size(); ++right) {
+            const auto right_begin = reinterpret_cast<std::uintptr_t>(sites[right].address);
+            const auto right_end = right_begin + sites[right].length;
+            if (left_begin < right_end && right_begin < left_end) {
+                ffnx_error("Shared Magic: overlapping patch sites.\n");
+                return false;
+            }
+        }
+    }
+
+    SYSTEM_INFO system_info{};
+    GetSystemInfo(&system_info);
+    const std::uintptr_t page_mask =
+        ~static_cast<std::uintptr_t>(system_info.dwPageSize - 1);
+    std::array<PatchPage, kMaxPatchPages> pages{};
+    std::size_t page_count = 0;
+    for (const PatchSite &site : sites) {
+        const auto first = reinterpret_cast<std::uintptr_t>(site.address) & page_mask;
+        const auto last = reinterpret_cast<std::uintptr_t>(site.address + site.length - 1) & page_mask;
+        for (auto page = first; page <= last; page += system_info.dwPageSize) {
+            bool known = false;
+            for (std::size_t index = 0; index < page_count; ++index) {
+                known = known || reinterpret_cast<std::uintptr_t>(pages[index].base) == page;
+            }
+            if (!known) {
+                if (page_count == pages.size()) {
+                    return false;
+                }
+                pages[page_count++] = {reinterpret_cast<std::uint8_t *>(page),
+                                       system_info.dwPageSize, 0, false};
+            }
+        }
+    }
+    if (!set_pages_writable(pages, page_count)) {
+        const bool protections_restored = restore_page_protections(pages, page_count);
+        ffnx_error("Shared Magic: page preflight failed; restore=%s.\n",
+                   protections_restored ? "complete" : "FAILED");
+        if (!protections_restored) {
+            hard_stop_unproved_patch_state("page preflight protection restore failed");
+        }
+        return false;
+    }
+    for (const PatchSite &site : sites) {
+        std::memcpy(site.address, site.replacement.data(), site.length);
+        if (std::memcmp(site.address, site.replacement.data(), site.length) != 0) {
+            const bool rolled_back = rollback_patches(sites, pages, page_count);
+            ffnx_error("Shared Magic: patch write/readback failed for %s; rollback=%s.\n",
+                       site.name, rolled_back ? "complete" : "FAILED");
+            if (!rolled_back) {
+                hard_stop_unproved_patch_state("patch write rollback failed");
+            }
+            return false;
+        }
+    }
+    if (!FlushInstructionCache(GetCurrentProcess(), nullptr, 0)) {
+        const bool rolled_back = rollback_patches(sites, pages, page_count);
+        ffnx_error("Shared Magic: instruction-cache flush failed; rollback=%s.\n",
+                   rolled_back ? "complete" : "FAILED");
+        if (!rolled_back) {
+            hard_stop_unproved_patch_state("instruction-cache rollback failed");
+        }
+        return false;
+    }
+    if (!restore_page_protections(pages, page_count)) {
+        const bool rolled_back = rollback_patches(sites, pages, page_count);
+        ffnx_error("Shared Magic: final page-protection restore failed; rollback=%s.\n",
+                   rolled_back ? "complete" : "FAILED");
+        if (!rolled_back) {
+            hard_stop_unproved_patch_state("page-protection rollback failed");
+        }
+        return false;
+    }
+    for (const PatchSite &site : sites) {
+        if (std::memcmp(site.address, site.replacement.data(), site.length) != 0) {
+            const bool rolled_back = rollback_patches(sites, pages, page_count);
+            ffnx_error("Shared Magic: patch readback failed for %s; rollback=%s.\n",
+                       site.name, rolled_back ? "complete" : "FAILED");
+            if (!rolled_back) {
+                hard_stop_unproved_patch_state("final readback rollback failed");
+            }
+            return false;
+        }
+    }
+    return true;
+}
+
+} // namespace
+
+void ff8_shared_magic_heartbeat()
+{
+    // Nothing to drain here any more: the message box owns the queue,
+    // holds each sentence long enough to read, and draws it the way FF8
+    // draws its own. FFNx's popup fades on a decay tuned for one word.
+
+    // The loader has returned. Use the renderer overlay, never the menu controller.
+    if (!g_activation_toast.empty() && get_popup_time() == 0) {
+        show_popup_msg(TEXTCOLOR_RED, "%s", g_activation_toast.c_str());
+        g_activation_toast.clear();
+    }
+    if (!g_requested && !g_installed && !g_install_failed &&
+        g_heartbeat_sequence != 0) {
+        return;
+    }
+    const ULONGLONG now = GetTickCount64();
+    if (g_last_heartbeat_tick != 0 && now - g_last_heartbeat_tick < 10000ULL) {
+        return;
+    }
+    g_last_heartbeat_tick = now;
+    log_launch_once();
+    unsigned int actor_mask = 0;
+    for (std::size_t actor = 0; actor < g_actor_ready.size(); ++actor) {
+        actor_mask |= g_actor_ready[actor] ? (1U << actor) : 0U;
+    }
+    char line[8192]{};
+    int used = std::snprintf(line, sizeof(line),
+        "heartbeat seq=%llu requested=%u installedFunctions=%u installedCalls=%u "
+        "active=%u phase=%s warning=%s actorMask=%u activation=%llu/%llu "
+        "reconcile=%llu/%llu save=%llu/%llu firstFailure=%s functionHits=",
+        static_cast<unsigned long long>(++g_heartbeat_sequence),
+        g_requested ? 1U : 0U, g_installed ? 28U : 0U,
+        g_installed ? 4U : 0U, g_state.shared_pool_active ? 1U : 0U,
+        phase_name(), warning_name(), actor_mask,
+        static_cast<unsigned long long>(g_activation_successes),
+        static_cast<unsigned long long>(g_activation_attempts),
+        static_cast<unsigned long long>(g_reconcile_successes),
+        static_cast<unsigned long long>(g_reconcile_attempts),
+        static_cast<unsigned long long>(g_save_successes),
+        static_cast<unsigned long long>(g_save_attempts),
+        g_first_failure.empty() ? "none" : g_first_failure.c_str());
+    for (std::size_t index = 0; index < g_function_hits.size() &&
+         used > 0 && static_cast<std::size_t>(used) < sizeof(line); ++index) {
+        used += std::snprintf(line + used, sizeof(line) - used, "%s%llu",
+            index == 0 ? "" : ",",
+            static_cast<unsigned long long>(g_function_hits[index]));
+    }
+    if (used > 0 && static_cast<std::size_t>(used) < sizeof(line)) {
+        used += std::snprintf(line + used, sizeof(line) - used, " callHits=");
+    }
+    for (std::size_t index = 0; index < g_call_site_hits.size() &&
+         used > 0 && static_cast<std::size_t>(used) < sizeof(line); ++index) {
+        used += std::snprintf(line + used, sizeof(line) - used, "%s%llu",
+            index == 0 ? "" : ",",
+            static_cast<unsigned long long>(g_call_site_hits[index]));
+    }
+    if (used > 0 && static_cast<std::size_t>(used) + 1 < sizeof(line)) {
+        line[used++] = '\n';
+        line[used] = '\0';
+    }
+    append_runtime_log(line);
+}
