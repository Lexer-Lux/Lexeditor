+
+bool readable_protection(DWORD protection)
+{
+    if ((protection & PAGE_GUARD) != 0 || (protection & PAGE_NOACCESS) != 0) return false;
+    const DWORD base = protection & 0xFFU;
+    return base == PAGE_READONLY || base == PAGE_READWRITE || base == PAGE_WRITECOPY ||
+           base == PAGE_EXECUTE_READ || base == PAGE_EXECUTE_READWRITE ||
+           base == PAGE_EXECUTE_WRITECOPY;
+}
+
+bool guarded_read(std::uintptr_t address, void *destination, std::size_t size)
+{
+    if (address == 0 || size == 0 || address > std::numeric_limits<std::uintptr_t>::max() - size) return false;
+    std::size_t checked = 0;
+    while (checked < size) {
+        MEMORY_BASIC_INFORMATION region{};
+        if (VirtualQuery(reinterpret_cast<const void *>(address + checked), &region,
+                         sizeof(region)) != sizeof(region) ||
+            region.State != MEM_COMMIT || !readable_protection(region.Protect)) return false;
+        const std::uintptr_t region_end = reinterpret_cast<std::uintptr_t>(region.BaseAddress)
+            + region.RegionSize;
+        if (region_end <= address + checked) return false;
+        checked += std::min(size - checked, static_cast<std::size_t>(region_end - (address + checked)));
+    }
+    SIZE_T copied = 0;
+    return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void *>(address),
+                             destination, size, &copied) != FALSE && copied == size;
+}
+
+std::vector<std::string> split(const std::string &value, char separator)
+{
+    std::vector<std::string> output;
+    std::size_t start = 0;
+    while (true) {
+        const std::size_t at = value.find(separator, start);
+        output.push_back(value.substr(start, at == std::string::npos ? at : at - start));
+        if (at == std::string::npos) return output;
+        start = at + 1;
+    }
+}
+
+bool integer(const std::string &text, std::int64_t &output)
+{
+    if (text.empty()) return false;
+    std::size_t used = 0;
+    try {
+        output = std::stoll(text, &used, 0);
+    } catch (...) { return false; }
+    return used == text.size();
+}
+
+bool numeric_match(std::int64_t actual, const std::string &values, bool &matched)
+{
+    matched = false;
+    const std::size_t range = values.find("..");
+    if (range != std::string::npos) {
+        if (values.find("..", range + 2) != std::string::npos) return false;
+        std::int64_t low = 0, high = 0;
+        if (!integer(values.substr(0, range), low) ||
+            !integer(values.substr(range + 2), high)) return false;
+        matched = low <= actual && actual <= high;
+        return true;
+    }
+    if (values.empty()) return false;
+    for (const std::string &choice : split(values, ',')) {
+        std::int64_t wanted = 0;
+        if (!integer(choice, wanted)) return false;
+        if (wanted == actual) matched = true;
+    }
+    return true;
+}
+
+bool parse_size(const std::string &text, std::int64_t &output)
+{
+    return integer(text, output) && output > 0 && output <= std::numeric_limits<std::int32_t>::max();
+}
+
+std::int64_t random_below(Database &database, std::int64_t size)
+{
+    return std::uniform_int_distribution<std::int64_t>(0, size - 1)(database.random);
+}
+
+bool string_match(const std::string &actual, const std::string &values, bool &matched)
+{
+    matched = false;
+    const std::string folded = lower_ascii(actual);
+    for (std::string choice : split(values, '|')) {
+        if (lower_ascii(std::move(choice)) == folded) matched = true;
+    }
+    return true;
+}
+
+bool evaluate_variable(Database &database, const Token &token, bool &result)
+{
+    const std::vector<std::string> parts = split(token.spec, ':');
+    if (parts.empty()) return false;
+    const std::string kind = lower_ascii(parts[0]);
+    std::int64_t actual = 0;
+    bool unlock_random_variable = false;
+
+    if (kind == "sys") {
+        if (parts.size() != 2) return false;
+        SYSTEMTIME now{}; GetLocalTime(&now);
+        const std::string field = lower_ascii(parts[1]);
+        if (field == "day") actual = now.wDay;
+        else if (field == "month") actual = now.wMonth;
+        else if (field == "year") actual = now.wYear;
+        else if (field == "hour") actual = now.wHour;
+        else if (field == "minute") actual = now.wMinute;
+        else if (field == "second") actual = now.wSecond;
+        else return false;
+    } else if (kind == "byte" || kind == "short" || kind == "int") {
+        if (parts.size() < 2 || parts.size() > 3) return false;
+        std::int64_t parsed_address = 0;
+        if (!integer(parts[1], parsed_address) || parsed_address <= 0 ||
+            static_cast<std::uint64_t>(parsed_address) > std::numeric_limits<std::uintptr_t>::max()) return false;
+        const std::uintptr_t address = static_cast<std::uintptr_t>(parsed_address);
+        if (kind == "byte") {
+            std::uint8_t value = 0; if (!guarded_read(address, &value, sizeof(value))) return false; actual = value;
+        } else if (kind == "short") {
+            std::int16_t value = 0; if (!guarded_read(address, &value, sizeof(value))) return false; actual = value;
+        } else {
+            std::int32_t value = 0; if (!guarded_read(address, &value, sizeof(value))) return false; actual = value;
+        }
+        if (parts.size() == 3) {
+            std::int64_t parsed_mask = 0;
+            if (!integer(parts[2], parsed_mask) || parsed_mask < std::numeric_limits<std::int32_t>::min() ||
+                parsed_mask > std::numeric_limits<std::uint32_t>::max()) return false;
+            const std::int32_t mask = static_cast<std::int32_t>(static_cast<std::uint32_t>(parsed_mask));
+            actual &= mask;
+        }
+    } else if (kind == "ffstring") {
+        if (parts.size() != 3) return false;
+        std::int64_t parsed_address = 0, parsed_size = 0;
+        if (!integer(parts[1], parsed_address) || parsed_address <= 0 ||
+            !parse_size(parts[2], parsed_size) || parsed_size > kMaxStringRead ||
+            static_cast<std::uint64_t>(parsed_address) > std::numeric_limits<std::uintptr_t>::max()) return false;
+        std::vector<std::uint8_t> bytes(static_cast<std::size_t>(parsed_size));
+        if (!guarded_read(static_cast<std::uintptr_t>(parsed_address), bytes.data(), bytes.size())) return false;
+        std::string translated;
+        for (const std::uint8_t value : bytes) {
+            if (value == 0xFFU) break;
+            translated.push_back(value <= 0x5EU ? static_cast<char>(' ' + value) : ' ');
+        }
+        return string_match(translated, token.values, result);
+    } else {
+        if ((kind == "randomvar" && (parts.size() < 3 || parts.size() > 4)) ||
+            (kind != "randomvar" && parts.size() != 3)) return false;
+        std::int64_t size = 0;
+        if (!parse_size(parts[2], size) || parts[1].empty()) return false;
+        const std::string key = lower_ascii(parts[1]);
+        if (kind == "counter") {
+            actual = database.counters[key] % size;
+        } else if (kind == "counteradv") {
+            actual = ++database.counters[key] % size;
+        } else if (kind == "counterrnd") {
+            actual = random_below(database, size); database.counters[key] = actual;
+        } else if (kind == "random") {
+            actual = random_below(database, size);
+        } else if (kind == "randomvaronce") {
+            auto [found, inserted] = database.random_values.try_emplace(key);
+            if (inserted) { found->second.value = random_below(database, size); found->second.generated = std::chrono::system_clock::now(); }
+            actual = found->second.value;
+        } else if (kind == "randomvar") {
+            std::int64_t lifetime = 0;
+            if (parts.size() == 4 && (!integer(parts[3], lifetime) || lifetime < 0)) return false;
+            auto [found, inserted] = database.random_values.try_emplace(key);
+            const auto now = std::chrono::system_clock::now();
+            if (inserted || (!found->second.locked && now > found->second.generated + std::chrono::seconds(lifetime))) {
+                found->second.value = random_below(database, size); found->second.generated = now;
+            }
+            found->second.locked = true;
+            actual = found->second.value;
+            unlock_random_variable = true;
+        } else return false;
+    }
+    if (!numeric_match(actual, token.values, result)) return false;
+    if (unlock_random_variable && result) database.random_values[lower_ascii(parts[1])].locked = false;
+    return true;
+}
+
+bool evaluate_expression(Database &database, const Expression &expression, bool &result)
+{
+    if (expression.token.operation == Token::Operation::variable) {
+        return evaluate_variable(database, expression.token, result);
+    }
+    if (expression.token.operation == Token::Operation::logical_not) {
+        if (expression.children.size() != 1 ||
+            !evaluate_expression(database, expression.children.front(), result)) return false;
+        result = !result;
+        return true;
+    }
+    const bool conjunction = expression.token.operation == Token::Operation::logical_and;
+    result = conjunction;
+    for (const Expression &child : expression.children) {
+        bool next = false;
+        if (!evaluate_expression(database, child, next)) return false;
+        if (conjunction && !next) { result = false; return true; }
+        if (!conjunction && next) { result = true; return true; }
+    }
+    return !expression.children.empty();
+}
+
+bool evaluate(Database &database, const Condition &condition, bool &result)
+{
+    return evaluate_expression(database, condition.root, result);
+}
+
+bool safe_relative(const std::string &path, const std::string &required_prefix)
+{
+    if (path.empty() || path.size() > 1024 || path.find('\\') != std::string::npos ||
+        path.find(':') != std::string::npos || path.find('\0') != std::string::npos ||
+        path.front() == '/') return false;
+    const std::string folded = lower_ascii(path);
+    if (!folded.starts_with(required_prefix)) return false;
+    for (const std::string &part : split(path, '/')) {
+        if (part.empty() || part == "." || part == "..") return false;
+    }
+    return true;
+}
