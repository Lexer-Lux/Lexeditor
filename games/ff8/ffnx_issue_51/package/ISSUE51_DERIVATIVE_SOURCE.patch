+		ff8_handle_ambient_playback();
+	}
+	else
+	{
+		if (ff7_do_reset)
+		{
+			if (ff7_externals.movie_object->is_playing)
+			{
+				ff7_do_reset = false;
+			}
+			else
+			{
+				switch(mode->driver_mode)
+				{
+					// Skip reset on these mode(s)
+					case MODE_MENU:
