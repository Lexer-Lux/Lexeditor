+        GetCurrentProcessId(), now.wYear, now.wMonth, now.wDay, now.wHour,
+        now.wMinute, now.wSecond, kSupportedExeSha256,
+        g_config_path.empty() ? "<not-resolved>" : g_config_path.c_str());
+    append_runtime_log(line);
