+extern "C" void __declspec(noinline) __cdecl issue51_before(
+    std::uintptr_t *return_slot, std::uint32_t raw_id);
+extern "C" std::uintptr_t __declspec(noinline) __cdecl issue51_after();
+extern "C" int __declspec(noinline) __cdecl issue51_should_bypass(
+    std::uint32_t raw_id);
+
+extern "C" int __declspec(noinline) __cdecl issue51_should_bypass(
+    const std::uint32_t raw_id)
+{
+    if (raw_id < g_function_hits.size()) {
+        ++g_function_hits[raw_id];
+        ++g_function_hit_total;
+    }
+    const HookId id = static_cast<HookId>(raw_id);
+    if (id == HookId::main_menu_controller &&
+        g_warning != MergeError::none) {
+        // FF8's dialog advance and clear functions synchronously re-enter the
+        // main-menu controller. Retain that nested controller call without
+        // advancing the same warning again.
+        if (g_warning_updating) {
+            return 1;
+        }
+        g_warning_updating = true;
+        const int result = update_warning_modal();
+        g_warning_updating = false;
+        return result;
+    }
+    return g_state.shared_pool_active &&
+           g_state.phase == RuntimePhase::shared_mirror &&
+           is_private_transaction_hook(id);
+}
