+namespace lexeditor::ff8::live_conditions {
+namespace {
+
+constexpr std::size_t kMaxManifestBytes = 16U * 1024U * 1024U;
+constexpr std::size_t kMaxJsonDepth = 32;
+constexpr std::size_t kMaxJsonNodes = 300000;
+constexpr std::size_t kMaxRoutes = 4096;
+constexpr std::size_t kMaxConditionsPerRoute = 12;
+constexpr std::size_t kMaxTokensPerCondition = 256;
+constexpr std::size_t kMaxVariantsPerRoute = 4096;
+constexpr std::size_t kMaxVariantsTotal = 65536;
+constexpr std::size_t kMaxStringRead = 4096;
+constexpr char kManifestRelative[] = "lexeditor/live-conditions.json";
+constexpr char kAssetPrefix[] = "lexeditor/conditional-variants/";
+
+std::string lower_ascii(std::string value)
+{
+    std::transform(value.begin(), value.end(), value.begin(), [](unsigned char value) {
+        return static_cast<char>(std::tolower(value));
+    });
+    return value;
+}
+
+struct Json final {
+    enum class Kind { null_value, boolean, integer, string, array, object };
+    Kind kind = Kind::null_value;
+    bool boolean = false;
+    std::int64_t integer = 0;
+    std::string string;
+    std::vector<Json> array;
+    std::map<std::string, Json> object;
+};
+
+class JsonParser final {
+public:
+    explicit JsonParser(std::string source) : source_(std::move(source)) {}
+
+    Json parse()
+    {
+        Json result = value(0);
+        whitespace();
+        if (position_ != source_.size()) {
+            throw std::runtime_error("JSON has trailing data");
+        }
+        return result;
+    }
+
+private:
+    std::string source_;
+    std::size_t position_ = 0;
+    std::size_t nodes_ = 0;
+
+    void whitespace()
+    {
+        while (position_ < source_.size() &&
+               std::isspace(static_cast<unsigned char>(source_[position_]))) {
+            ++position_;
+        }
+    }
+
+    char take()
+    {
+        if (position_ >= source_.size()) {
+            throw std::runtime_error("Unexpected end of JSON");
+        }
+        return source_[position_++];
+    }
+
+    void literal(const char *text)
+    {
+        while (*text != '\0') {
+            if (take() != *text++) {
+                throw std::runtime_error("Invalid JSON literal");
+            }
+        }
+    }
+
+    static void append_utf8(std::string &output, std::uint32_t value)
+    {
+        if (value <= 0x7FU) {
+            output.push_back(static_cast<char>(value));
+        } else if (value <= 0x7FFU) {
+            output.push_back(static_cast<char>(0xC0U | (value >> 6)));
+            output.push_back(static_cast<char>(0x80U | (value & 0x3FU)));
+        } else if (value <= 0xFFFFU) {
+            output.push_back(static_cast<char>(0xE0U | (value >> 12)));
+            output.push_back(static_cast<char>(0x80U | ((value >> 6) & 0x3FU)));
+            output.push_back(static_cast<char>(0x80U | (value & 0x3FU)));
+        } else {
+            output.push_back(static_cast<char>(0xF0U | (value >> 18)));
+            output.push_back(static_cast<char>(0x80U | ((value >> 12) & 0x3FU)));
+            output.push_back(static_cast<char>(0x80U | ((value >> 6) & 0x3FU)));
+            output.push_back(static_cast<char>(0x80U | (value & 0x3FU)));
+        }
+    }
+
+    std::uint32_t hex4()
+    {
+        std::uint32_t result = 0;
+        for (int index = 0; index < 4; ++index) {
+            const char digit = take();
+            result <<= 4;
+            if (digit >= '0' && digit <= '9') result |= digit - '0';
+            else if (digit >= 'a' && digit <= 'f') result |= digit - 'a' + 10;
+            else if (digit >= 'A' && digit <= 'F') result |= digit - 'A' + 10;
+            else throw std::runtime_error("Invalid JSON Unicode escape");
+        }
+        return result;
+    }
+
+    std::string string()
+    {
+        if (take() != '"') throw std::runtime_error("JSON string is missing a quote");
+        std::string output;
+        while (true) {
+            const unsigned char value = static_cast<unsigned char>(take());
+            if (value == '"') break;
+            if (value < 0x20U) throw std::runtime_error("JSON string has a control byte");
+            if (value != '\\') {
+                output.push_back(static_cast<char>(value));
+                continue;
+            }
+            switch (take()) {
+            case '"': output.push_back('"'); break;
+            case '\\': output.push_back('\\'); break;
+            case '/': output.push_back('/'); break;
+            case 'b': output.push_back('\b'); break;
+            case 'f': output.push_back('\f'); break;
+            case 'n': output.push_back('\n'); break;
+            case 'r': output.push_back('\r'); break;
+            case 't': output.push_back('\t'); break;
+            case 'u': {
+                std::uint32_t codepoint = hex4();
+                if (codepoint >= 0xD800U && codepoint <= 0xDBFFU) {
+                    if (take() != '\\' || take() != 'u') {
+                        throw std::runtime_error("JSON high surrogate has no pair");
+                    }
+                    const std::uint32_t low = hex4();
+                    if (low < 0xDC00U || low > 0xDFFFU) {
+                        throw std::runtime_error("JSON surrogate pair is invalid");
+                    }
+                    codepoint = 0x10000U + ((codepoint - 0xD800U) << 10)
+                        + (low - 0xDC00U);
+                } else if (codepoint >= 0xDC00U && codepoint <= 0xDFFFU) {
+                    throw std::runtime_error("JSON has an unpaired low surrogate");
+                }
+                append_utf8(output, codepoint);
+                break;
+            }
+            default: throw std::runtime_error("JSON escape is invalid");
+            }
+        }
+        return output;
+    }
+
+    Json number()
+    {
+        const std::size_t start = position_;
+        if (source_[position_] == '-') ++position_;
+        if (position_ >= source_.size() || !std::isdigit(
+                static_cast<unsigned char>(source_[position_]))) {
+            throw std::runtime_error("JSON number is invalid");
+        }
+        if (source_[position_] == '0') {
+            ++position_;
+        } else {
+            while (position_ < source_.size() && std::isdigit(
+                    static_cast<unsigned char>(source_[position_]))) ++position_;
+        }
+        if (position_ < source_.size() &&
+            (source_[position_] == '.' || source_[position_] == 'e' ||
+             source_[position_] == 'E')) {
+            throw std::runtime_error("Live-condition JSON accepts integers only");
+        }
+        Json result;
+        result.kind = Json::Kind::integer;
+        try {
+            result.integer = std::stoll(source_.substr(start, position_ - start));
+        } catch (...) {
+            throw std::runtime_error("JSON integer is out of range");
+        }
+        return result;
+    }
+
+    Json value(std::size_t depth)
+    {
+        if (depth > kMaxJsonDepth || ++nodes_ > kMaxJsonNodes) {
+            throw std::runtime_error("JSON complexity limit exceeded");
+        }
+        whitespace();
+        if (position_ >= source_.size()) throw std::runtime_error("JSON value is missing");
+        const char first = source_[position_];
+        if (first == '"') {
+            Json result; result.kind = Json::Kind::string; result.string = string(); return result;
+        }
+        if (first == '-' || std::isdigit(static_cast<unsigned char>(first))) return number();
+        if (first == 'n') { literal("null"); return {}; }
+        if (first == 't') { literal("true"); Json result; result.kind = Json::Kind::boolean; result.boolean = true; return result; }
+        if (first == 'f') { literal("false"); Json result; result.kind = Json::Kind::boolean; return result; }
+        if (first == '[') {
+            take(); Json result; result.kind = Json::Kind::array; whitespace();
+            if (position_ < source_.size() && source_[position_] == ']') { ++position_; return result; }
+            while (true) {
+                result.array.push_back(value(depth + 1)); whitespace();
+                const char separator = take();
+                if (separator == ']') break;
+                if (separator != ',') throw std::runtime_error("JSON array separator is invalid");
+            }
+            return result;
+        }
+        if (first == '{') {
+            take(); Json result; result.kind = Json::Kind::object; whitespace();
+            if (position_ < source_.size() && source_[position_] == '}') { ++position_; return result; }
+            while (true) {
+                whitespace();
+                if (position_ >= source_.size() || source_[position_] != '"') {
+                    throw std::runtime_error("JSON object key is invalid");
+                }
+                std::string key = string(); whitespace();
+                if (take() != ':') throw std::runtime_error("JSON object has no colon");
+                if (!result.object.emplace(std::move(key), value(depth + 1)).second) {
+                    throw std::runtime_error("JSON object has a duplicate key");
+                }
+                whitespace();
+                const char separator = take();
+                if (separator == '}') break;
+                if (separator != ',') throw std::runtime_error("JSON object separator is invalid");
+            }
+            return result;
+        }
+        throw std::runtime_error("JSON value is invalid");
+    }
+};
+
+const Json &member(const Json &object, const char *name, Json::Kind kind)
+{
+    if (object.kind != Json::Kind::object) throw std::runtime_error("Expected JSON object");
+    const auto found = object.object.find(name);
+    if (found == object.object.end() || found->second.kind != kind) {
+        throw std::runtime_error(std::string("Invalid or missing JSON field: ") + name);
+    }
+    return found->second;
+}
+
+void exact_keys(const Json &object, std::initializer_list<const char *> required,
+                std::initializer_list<const char *> optional = {})
+{
+    std::vector<std::string> allowed;
+    for (const char *key : required) allowed.emplace_back(key);
+    for (const char *key : optional) allowed.emplace_back(key);
+    for (const auto &[key, value] : object.object) {
+        (void)value;
+        if (std::find(allowed.begin(), allowed.end(), key) == allowed.end()) {
+            throw std::runtime_error("Unknown JSON field: " + key);
+        }
+    }
+    for (const char *key : required) {
+        if (!object.object.contains(key)) throw std::runtime_error(std::string("Missing JSON field: ") + key);
+    }
+}
+
+struct Token final {
+    enum class Operation { variable, logical_not, logical_and, logical_or } operation;
+    std::string spec;
+    std::string values;
+    std::size_t arity = 0;
+};
+
+struct Expression final {
+    Token token{};
+    std::vector<Expression> children;
+};
+struct Condition final { Expression root; };
+struct Target final { bool pass_through = true; std::filesystem::path asset; };
+struct Route final {
+    std::vector<Condition> conditions;
+    std::unordered_map<std::uint32_t, Target> variants;
+    Target fallback;
+};
+
+struct RandomValue final {
+    std::int64_t value = 0;
+    std::chrono::system_clock::time_point generated{};
+    bool locked = true;
+};
+
+struct Database final {
+    std::filesystem::path direct_root;
+    std::unordered_map<std::string, Route> routes;
+    std::unordered_map<std::string, std::int64_t> counters;
+    std::unordered_map<std::string, RandomValue> random_values;
+    std::mt19937_64 random{std::random_device{}()};
+};
+
+bool readable_protection(DWORD protection)
+{
+    if ((protection & PAGE_GUARD) != 0 || (protection & PAGE_NOACCESS) != 0) return false;
+    const DWORD base = protection & 0xFFU;
+    return base == PAGE_READONLY || base == PAGE_READWRITE || base == PAGE_WRITECOPY ||
+           base == PAGE_EXECUTE_READ || base == PAGE_EXECUTE_READWRITE ||
+           base == PAGE_EXECUTE_WRITECOPY;
+}
+
+bool guarded_read(std::uintptr_t address, void *destination, std::size_t size)
+{
+    if (address == 0 || size == 0 || address > std::numeric_limits<std::uintptr_t>::max() - size) return false;
+    std::size_t checked = 0;
+    while (checked < size) {
+        MEMORY_BASIC_INFORMATION region{};
+        if (VirtualQuery(reinterpret_cast<const void *>(address + checked), &region,
+                         sizeof(region)) != sizeof(region) ||
+            region.State != MEM_COMMIT || !readable_protection(region.Protect)) return false;
+        const std::uintptr_t region_end = reinterpret_cast<std::uintptr_t>(region.BaseAddress)
+            + region.RegionSize;
+        if (region_end <= address + checked) return false;
+        checked += std::min(size - checked, static_cast<std::size_t>(region_end - (address + checked)));
+    }
+    SIZE_T copied = 0;
+    return ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void *>(address),
+                             destination, size, &copied) != FALSE && copied == size;
+}
+
+std::vector<std::string> split(const std::string &value, char separator)
+{
+    std::vector<std::string> output;
+    std::size_t start = 0;
+    while (true) {
+        const std::size_t at = value.find(separator, start);
+        output.push_back(value.substr(start, at == std::string::npos ? at : at - start));
+        if (at == std::string::npos) return output;
+        start = at + 1;
+    }
+}
+
+bool integer(const std::string &text, std::int64_t &output)
+{
+    if (text.empty()) return false;
+    std::size_t used = 0;
+    try {
+        output = std::stoll(text, &used, 0);
+    } catch (...) { return false; }
+    return used == text.size();
+}
+
+bool numeric_match(std::int64_t actual, const std::string &values, bool &matched)
+{
+    matched = false;
+    const std::size_t range = values.find("..");
+    if (range != std::string::npos) {
+        if (values.find("..", range + 2) != std::string::npos) return false;
+        std::int64_t low = 0, high = 0;
+        if (!integer(values.substr(0, range), low) ||
+            !integer(values.substr(range + 2), high)) return false;
+        matched = low <= actual && actual <= high;
+        return true;
+    }
+    if (values.empty()) return false;
+    for (const std::string &choice : split(values, ',')) {
+        std::int64_t wanted = 0;
+        if (!integer(choice, wanted)) return false;
+        if (wanted == actual) matched = true;
+    }
+    return true;
+}
+
+bool parse_size(const std::string &text, std::int64_t &output)
+{
+    return integer(text, output) && output > 0 && output <= std::numeric_limits<std::int32_t>::max();
+}
+
+std::int64_t random_below(Database &database, std::int64_t size)
+{
+    return std::uniform_int_distribution<std::int64_t>(0, size - 1)(database.random);
+}
+
+bool string_match(const std::string &actual, const std::string &values, bool &matched)
+{
+    matched = false;
+    const std::string folded = lower_ascii(actual);
+    for (std::string choice : split(values, '|')) {
+        if (lower_ascii(std::move(choice)) == folded) matched = true;
+    }
+    return true;
+}
+
+bool evaluate_variable(Database &database, const Token &token, bool &result)
+{
+    const std::vector<std::string> parts = split(token.spec, ':');
+    if (parts.empty()) return false;
+    const std::string kind = lower_ascii(parts[0]);
+    std::int64_t actual = 0;
+    bool unlock_random_variable = false;
+
+    if (kind == "sys") {
+        if (parts.size() != 2) return false;
+        SYSTEMTIME now{}; GetLocalTime(&now);
+        const std::string field = lower_ascii(parts[1]);
+        if (field == "day") actual = now.wDay;
+        else if (field == "month") actual = now.wMonth;
+        else if (field == "year") actual = now.wYear;
+        else if (field == "hour") actual = now.wHour;
+        else if (field == "minute") actual = now.wMinute;
+        else if (field == "second") actual = now.wSecond;
+        else return false;
+    } else if (kind == "byte" || kind == "short" || kind == "int") {
+        if (parts.size() < 2 || parts.size() > 3) return false;
+        std::int64_t parsed_address = 0;
+        if (!integer(parts[1], parsed_address) || parsed_address <= 0 ||
+            static_cast<std::uint64_t>(parsed_address) > std::numeric_limits<std::uintptr_t>::max()) return false;
+        const std::uintptr_t address = static_cast<std::uintptr_t>(parsed_address);
+        if (kind == "byte") {
+            std::uint8_t value = 0; if (!guarded_read(address, &value, sizeof(value))) return false; actual = value;
+        } else if (kind == "short") {
+            std::int16_t value = 0; if (!guarded_read(address, &value, sizeof(value))) return false; actual = value;
+        } else {
+            std::int32_t value = 0; if (!guarded_read(address, &value, sizeof(value))) return false; actual = value;
+        }
+        if (parts.size() == 3) {
+            std::int64_t parsed_mask = 0;
+            if (!integer(parts[2], parsed_mask) || parsed_mask < std::numeric_limits<std::int32_t>::min() ||
+                parsed_mask > std::numeric_limits<std::uint32_t>::max()) return false;
+            const std::int32_t mask = static_cast<std::int32_t>(static_cast<std::uint32_t>(parsed_mask));
+            actual &= mask;
+        }
+    } else if (kind == "ffstring") {
+        if (parts.size() != 3) return false;
+        std::int64_t parsed_address = 0, parsed_size = 0;
+        if (!integer(parts[1], parsed_address) || parsed_address <= 0 ||
+            !parse_size(parts[2], parsed_size) || parsed_size > kMaxStringRead ||
+            static_cast<std::uint64_t>(parsed_address) > std::numeric_limits<std::uintptr_t>::max()) return false;
+        std::vector<std::uint8_t> bytes(static_cast<std::size_t>(parsed_size));
+        if (!guarded_read(static_cast<std::uintptr_t>(parsed_address), bytes.data(), bytes.size())) return false;
+        std::string translated;
+        for (const std::uint8_t value : bytes) {
+            if (value == 0xFFU) break;
+            translated.push_back(value <= 0x5EU ? static_cast<char>(' ' + value) : ' ');
+        }
+        return string_match(translated, token.values, result);
+    } else {
+        if ((kind == "randomvar" && (parts.size() < 3 || parts.size() > 4)) ||
+            (kind != "randomvar" && parts.size() != 3)) return false;
+        std::int64_t size = 0;
+        if (!parse_size(parts[2], size) || parts[1].empty()) return false;
+        const std::string key = lower_ascii(parts[1]);
+        if (kind == "counter") {
+            actual = database.counters[key] % size;
+        } else if (kind == "counteradv") {
+            actual = ++database.counters[key] % size;
+        } else if (kind == "counterrnd") {
+            actual = random_below(database, size); database.counters[key] = actual;
+        } else if (kind == "random") {
+            actual = random_below(database, size);
+        } else if (kind == "randomvaronce") {
+            auto [found, inserted] = database.random_values.try_emplace(key);
+            if (inserted) { found->second.value = random_below(database, size); found->second.generated = std::chrono::system_clock::now(); }
+            actual = found->second.value;
+        } else if (kind == "randomvar") {
+            std::int64_t lifetime = 0;
+            if (parts.size() == 4 && (!integer(parts[3], lifetime) || lifetime < 0)) return false;
+            auto [found, inserted] = database.random_values.try_emplace(key);
+            const auto now = std::chrono::system_clock::now();
+            if (inserted || (!found->second.locked && now > found->second.generated + std::chrono::seconds(lifetime))) {
+                found->second.value = random_below(database, size); found->second.generated = now;
+            }
+            found->second.locked = true;
+            actual = found->second.value;
+            unlock_random_variable = true;
+        } else return false;
+    }
+    if (!numeric_match(actual, token.values, result)) return false;
+    if (unlock_random_variable && result) database.random_values[lower_ascii(parts[1])].locked = false;
+    return true;
+}
+
+bool evaluate_expression(Database &database, const Expression &expression, bool &result)
+{
+    if (expression.token.operation == Token::Operation::variable) {
+        return evaluate_variable(database, expression.token, result);
+    }
+    if (expression.token.operation == Token::Operation::logical_not) {
+        if (expression.children.size() != 1 ||
+            !evaluate_expression(database, expression.children.front(), result)) return false;
+        result = !result;
+        return true;
+    }
+    const bool conjunction = expression.token.operation == Token::Operation::logical_and;
+    result = conjunction;
+    for (const Expression &child : expression.children) {
+        bool next = false;
+        if (!evaluate_expression(database, child, next)) return false;
+        if (conjunction && !next) { result = false; return true; }
+        if (!conjunction && next) { result = true; return true; }
+    }
+    return !expression.children.empty();
+}
+
+bool evaluate(Database &database, const Condition &condition, bool &result)
+{
+    return evaluate_expression(database, condition.root, result);
+}
+
+bool safe_relative(const std::string &path, const std::string &required_prefix)
+{
+    if (path.empty() || path.size() > 1024 || path.find('\\') != std::string::npos ||
+        path.find(':') != std::string::npos || path.find('\0') != std::string::npos ||
+        path.front() == '/') return false;
+    const std::string folded = lower_ascii(path);
+    if (!folded.starts_with(required_prefix)) return false;
+    for (const std::string &part : split(path, '/')) {
+        if (part.empty() || part == "." || part == "..") return false;
+    }
+    return true;
+}
+
+bool path_below(const std::filesystem::path &child, const std::filesystem::path &parent)
+{
+    auto child_it = child.begin();
+    for (auto parent_it = parent.begin(); parent_it != parent.end(); ++parent_it, ++child_it) {
+        if (child_it == child.end() || lower_ascii(child_it->string()) != lower_ascii(parent_it->string())) return false;
+    }
+    return true;
+}
+
+std::string sha256(const std::filesystem::path &path)
+{
+    std::string digest;
+    CryptoPP::SHA256 hash;
+    CryptoPP::FileSource source(path.string().c_str(), true,
+        new CryptoPP::HashFilter(hash,
+            new CryptoPP::HexEncoder(new CryptoPP::StringSink(digest), false)));
+    return lower_ascii(digest);
+}
+
+Target parse_target(const Json &value, const std::filesystem::path &direct_root,
+                    std::unordered_map<std::string, std::string> &verified)
+{
+    member(value, "mode", Json::Kind::string);
+    const bool has_pass = value.object.contains("passThrough");
+    const bool has_asset = value.object.contains("asset") || value.object.contains("sha256");
+    if (has_pass == has_asset) throw std::runtime_error("Target must be pass-through or an asset");
+    if (has_pass) {
+        if (!member(value, "passThrough", Json::Kind::boolean).boolean) {
+            throw std::runtime_error("passThrough must be true");
+        }
+        return {};
+    }
+    const std::string relative = member(value, "asset", Json::Kind::string).string;
+    const std::string digest = lower_ascii(member(value, "sha256", Json::Kind::string).string);
+    if (digest.size() != 64 || !std::all_of(digest.begin(), digest.end(), [](unsigned char value) {
+            return std::isxdigit(value) != 0;
+        }) || !safe_relative(relative, kAssetPrefix)) {
+        throw std::runtime_error("Conditional asset identity is invalid");
+    }
+    const std::filesystem::path filename = std::filesystem::path(relative).filename();
+    if (!lower_ascii(filename.string()).starts_with(digest.substr(0, 24))) {
+        throw std::runtime_error("Conditional asset filename does not match its hash");
+    }
+    const std::filesystem::path candidate = std::filesystem::weakly_canonical(direct_root / relative);
+    const std::filesystem::path allowed = std::filesystem::weakly_canonical(direct_root / "lexeditor" / "conditional-variants");
+    std::error_code file_error;
+    if (!path_below(candidate, allowed) || !std::filesystem::is_regular_file(candidate, file_error) || file_error) {
+        throw std::runtime_error("Conditional asset is missing or escapes its root");
+    }
+    const std::string candidate_key = lower_ascii(candidate.string());
+    const auto existing = verified.find(candidate_key);
+    if (existing != verified.end()) {
+        if (existing->second != digest) throw std::runtime_error("One asset has multiple digests");
+    } else {
+        if (sha256(candidate) != digest) throw std::runtime_error("Conditional asset hash does not match");
+        verified.emplace(candidate_key, digest);
+    }
+    Target output; output.pass_through = false; output.asset = candidate; return output;
+}
+
+Token parse_token(const Json &value)
+{
+    const std::string operation = lower_ascii(member(value, "op", Json::Kind::string).string);
+    Token token{};
+    if (operation == "var") {
+        exact_keys(value, {"op", "spec", "values"});
+        token.operation = Token::Operation::variable;
+        token.spec = member(value, "spec", Json::Kind::string).string;
+        token.values = member(value, "values", Json::Kind::string).string;
+        if (token.spec.empty() || token.values.empty()) throw std::runtime_error("Runtime variable is empty");
+        return token;
+    }
+    exact_keys(value, {"op", "arity"});
+    const std::int64_t arity = member(value, "arity", Json::Kind::integer).integer;
+    if (arity <= 0 || arity > static_cast<std::int64_t>(kMaxTokensPerCondition)) {
+        throw std::runtime_error("Runtime operation arity is invalid");
+    }
+    token.arity = static_cast<std::size_t>(arity);
+    if (operation == "not" && token.arity == 1) token.operation = Token::Operation::logical_not;
+    else if (operation == "and") token.operation = Token::Operation::logical_and;
+    else if (operation == "or") token.operation = Token::Operation::logical_or;
+    else throw std::runtime_error("Runtime operation is unsupported");
+    return token;
+}
+
+std::unique_ptr<Database> load(const std::filesystem::path &direct_root)
+{
+    const std::filesystem::path manifest = direct_root / kManifestRelative;
+    std::error_code size_error;
+    const std::uintmax_t size = std::filesystem::file_size(manifest, size_error);
+    if (size_error || size == 0 || size > kMaxManifestBytes) return {};
+    std::ifstream stream(manifest, std::ios::binary);
+    if (!stream) return {};
+    std::string source(static_cast<std::size_t>(size), '\0');
+    stream.read(source.data(), static_cast<std::streamsize>(source.size()));
+    if (!stream || stream.gcount() != static_cast<std::streamsize>(source.size())) return {};
+    Json root = JsonParser(std::move(source)).parse();
+    exact_keys(root, {"schemaVersion", "liveConditionalRoutes"});
+    if (member(root, "schemaVersion", Json::Kind::integer).integer != 1) return {};
+    const Json &route_values = member(root, "liveConditionalRoutes", Json::Kind::array);
+    if (route_values.array.size() > kMaxRoutes) return {};
+    auto database = std::make_unique<Database>();
+    database->direct_root = std::filesystem::weakly_canonical(direct_root);
+    std::unordered_map<std::string, std::string> verified;
+    std::size_t total_variants = 0;
+    for (const Json &value : route_values.array) {
+        try {
+            exact_keys(value, {"routeVersion", "logicalPath", "status", "outcomeEncoding",
+                               "conditions", "variants", "fallback"}, {"rejected"});
+            if (member(value, "routeVersion", Json::Kind::integer).integer != 1 ||
+                member(value, "status", Json::Kind::string).string != "ready: final variants precomposed" ||
+                member(value, "outcomeEncoding", Json::Kind::string).string !=
+                    "condition-id bitmask, least-significant bit first") continue;
+            const std::string logical = lower_ascii(member(value, "logicalPath", Json::Kind::string).string);
+            const std::string root_name = logical.substr(0, logical.find('/'));
+            if (!safe_relative(logical, root_name + "/") ||
+                (root_name != "direct" && root_name != "sfx" && root_name != "voice" && root_name != "ambient")) continue;
+            Route route;
+            const Json &condition_values = member(value, "conditions", Json::Kind::array);
+            if (condition_values.array.size() > kMaxConditionsPerRoute) continue;
+            for (std::size_t id = 0; id < condition_values.array.size(); ++id) {
+                const Json &condition_value = condition_values.array[id];
+                exact_keys(condition_value, {"id", "program"});
+                if (member(condition_value, "id", Json::Kind::integer).integer != static_cast<std::int64_t>(id)) {
+                    throw std::runtime_error("Condition IDs are not contiguous");
+                }
+                const Json &program = member(condition_value, "program", Json::Kind::array);
+                if (program.array.empty() || program.array.size() > kMaxTokensPerCondition) {
+                    throw std::runtime_error("Condition program size is invalid");
+                }
+                std::vector<Expression> stack;
+                for (const Json &token_value : program.array) {
+                    Token token = parse_token(token_value);
+                    Expression expression; expression.token = std::move(token);
+                    if (expression.token.operation != Token::Operation::variable) {
+                        if (expression.token.arity > stack.size()) {
+                            throw std::runtime_error("Postfix condition underflows");
+                        }
+                        const std::size_t first = stack.size() - expression.token.arity;
+                        for (std::size_t index = first; index < stack.size(); ++index) {
+                            expression.children.push_back(std::move(stack[index]));
+                        }
+                        stack.resize(first);
+                    }
+                    stack.push_back(std::move(expression));
+                }
+                if (stack.size() != 1) throw std::runtime_error("Postfix condition has extra values");
+                Condition condition; condition.root = std::move(stack.front());
+                route.conditions.push_back(std::move(condition));
+            }
+            const Json &variant_values = member(value, "variants", Json::Kind::array);
+            const std::size_t expected = std::size_t{1} << route.conditions.size();
+            if (variant_values.array.size() != expected || expected > kMaxVariantsPerRoute ||
+                total_variants + expected > kMaxVariantsTotal) continue;
+            for (const Json &variant_value : variant_values.array) {
+                exact_keys(variant_value, {"outcome", "mode", "sources"},
+                           {"conflicts", "passThrough", "asset", "sha256"});
+                const std::int64_t outcome = member(variant_value, "outcome", Json::Kind::integer).integer;
+                if (outcome < 0 || static_cast<std::size_t>(outcome) >= expected) {
+                    throw std::runtime_error("Variant outcome is out of range");
+                }
+                member(variant_value, "sources", Json::Kind::array);
+                if (!route.variants.emplace(static_cast<std::uint32_t>(outcome),
+                        parse_target(variant_value, database->direct_root, verified)).second) {
+                    throw std::runtime_error("Variant outcome is duplicated");
+                }
+            }
+            if (route.variants.size() != expected) throw std::runtime_error("Variant outcome is missing");
+            const Json &fallback_value = member(value, "fallback", Json::Kind::object);
+            exact_keys(fallback_value, {"mode"},
+                       {"conflicts", "passThrough", "asset", "sha256"});
+            route.fallback = parse_target(fallback_value,
+                                          database->direct_root, verified);
+            if (!database->routes.emplace(logical, std::move(route)).second) {
+                throw std::runtime_error("Logical route is duplicated");
+            }
+            total_variants += expected;
+        } catch (...) {
+            // A malformed route is inert. Other independently valid routes
+            // remain usable, and normal FFNx lookup is its fallback.
+        }
+    }
+    return database;
+}
+
+std::mutex state_mutex;
+std::unique_ptr<Database> database;
+std::filesystem::path loaded_root;
+bool load_attempted = false;
+
+} // namespace
+
+bool resolve(const std::filesystem::path &direct_root, std::string_view logical_path,
+             std::filesystem::path &selected) noexcept
+{
+    try {
+        std::lock_guard lock(state_mutex);
+        const std::filesystem::path canonical_root = std::filesystem::weakly_canonical(direct_root);
+        if (!load_attempted || canonical_root != loaded_root) {
+            database.reset();
+            loaded_root = canonical_root;
+            load_attempted = true;
+            try { database = load(canonical_root); }
+            catch (...) { database.reset(); }
+        }
+        if (!database) return false;
+        std::string logical(logical_path);
+        std::replace(logical.begin(), logical.end(), '\\', '/');
+        logical = lower_ascii(std::move(logical));
+        const auto found = database->routes.find(logical);
+        if (found == database->routes.end()) return false;
+        Route &route = found->second;
+        std::uint32_t outcome = 0;
+        bool valid = true;
+        for (std::size_t id = 0; id < route.conditions.size(); ++id) {
+            bool active = false;
+            if (!evaluate(*database, route.conditions[id], active)) { valid = false; break; }
+            if (active) outcome |= std::uint32_t{1} << id;
+        }
+        const Target *target = &route.fallback;
+        if (valid) {
+            const auto variant = route.variants.find(outcome);
+            if (variant != route.variants.end()) target = &variant->second;
+        }
+        if (target->pass_through) return false;
+        selected = target->asset;
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+void reset_for_tests() noexcept
+{
+    std::lock_guard lock(state_mutex);
+    database.reset(); loaded_root.clear(); load_attempted = false;
+}
+
+} // namespace lexeditor::ff8::live_conditions
