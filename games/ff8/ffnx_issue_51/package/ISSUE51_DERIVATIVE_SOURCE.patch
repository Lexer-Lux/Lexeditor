+	struct ff8_file* file = ff8_open_file(file_context, filename);
+	uint32_t i, len;
+
+	if(!file) goto error;
+	if(!ff8_read_file(sizeof(*ret), ret, file)) goto error;
+
+	ret->image_data = 0;
+	ret->old_palette_data = 0;
+	ret->palette_colorkey = 0;
+	ret->tex_format.palette_data = 0;
