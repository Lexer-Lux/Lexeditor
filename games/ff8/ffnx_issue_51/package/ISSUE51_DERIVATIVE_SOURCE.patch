+std::array<float, 2> Renderer::projectGamePointToScreen(float x, float y) const
+{
+    // Apply the same two orthographic projections and framebuffer quad as
+    // calcBackendProjMatrix() and renderFrame(). Return window fractions.
+    const float left = widescreen_enabled ? wide_viewport_x : 0.0f;
+    const float width = widescreen_enabled ? wide_viewport_width : game_width;
+    const float height = widescreen_enabled ? wide_game_height : game_height;
+    const float outputWidth = widescreen_enabled ? wide_game_width : game_width;
+    const float outputHeight = widescreen_enabled ? wide_game_height : game_height;
+    if (width <= 0.0f || height <= 0.0f || outputWidth <= 0.0f || outputHeight <= 0.0f) return {0.0f, 0.0f};
+    const float quadLeft = aspect_ratio == AR_STRETCH ? 0.0f : framebufferVertexOffsetX;
+    const float quadWidth = aspect_ratio == AR_STRETCH ? game_width : framebufferVertexWidth;
+    if (quadWidth <= 0.0f) return {0.0f, 0.0f};
+    const float screenX = (quadLeft + (x - left) * quadWidth / width) / outputWidth;
+    const float screenY = (y * game_height / height) / outputHeight;
+    return {screenX, screenY};
+}
