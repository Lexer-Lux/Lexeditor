+void exact_keys(const Json &object, std::initializer_list<const char *> required,
+                std::initializer_list<const char *> optional = {})
+{
+    std::vector<std::string> allowed;
+    for (const char *key : required) allowed.emplace_back(key);
+    for (const char *key : optional) allowed.emplace_back(key);
+    for (const auto &[key, value] : object.object) {
+        (void)value;
+        if (std::find(allowed.begin(), allowed.end(), key) == allowed.end()) {
+            throw std::runtime_error("Unknown JSON field: " + key);
+        }
+    }
+    for (const char *key : required) {
+        if (!object.object.contains(key)) throw std::runtime_error(std::string("Missing JSON field: ") + key);
+    }
+}
