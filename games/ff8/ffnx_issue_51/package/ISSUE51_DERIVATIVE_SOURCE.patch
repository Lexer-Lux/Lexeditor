+                           f"lexeditor_ff8_shared_magic_{name}()"))]
+        require("return 1U;" in body,
+                f"static package evidence changed: {name}")
+
+
+def bytes_at(pe: pefile.PE, image: bytes, address: int, size: int) -> bytes:
+    offset = pe.get_offset_from_rva(address - pe.OPTIONAL_HEADER.ImageBase)
+    return image[offset:offset + size]
+
+
+def direct_call_map(pe: pefile.PE, targets: set[int]) -> dict[int, set[int]]:
+    text_section = next(section for section in pe.sections
+                        if section.Name.rstrip(b"\0") == b".text")
+    data = text_section.get_data()
+    start = pe.OPTIONAL_HEADER.ImageBase + text_section.VirtualAddress
+    decoder = Cs(CS_ARCH_X86, CS_MODE_32)
+    decoder.skipdata = True
+    result = {target: set() for target in targets}
+    for instruction in decoder.disasm(data, start):
+        if instruction.mnemonic == "call" and instruction.op_str.startswith("0x"):
+            target = int(instruction.op_str, 16)
+            if target in result:
+                result[target].add(instruction.address)
+    return result
+
+
+def call_targets_in_range(pe: pefile.PE, image: bytes,
+                          start: int, end: int) -> set[int]:
+    decoder = Cs(CS_ARCH_X86, CS_MODE_32)
+    decoder.skipdata = True
+    result: set[int] = set()
+    for instruction in decoder.disasm(bytes_at(pe, image, start, end - start), start):
+        if instruction.mnemonic == "call" and instruction.op_str.startswith("0x"):
+            result.add(int(instruction.op_str, 16))
+    return result
+
+
+def check_executable(path: Path) -> None:
+    image = path.read_bytes()
+    require(hashlib.sha256(image).hexdigest() == EXE_SHA256,
+            "supported executable hash changed")
+    pe = pefile.PE(data=image, fast_load=True)
+    for name, (address, guard_hex) in HOOKS.items():
+        guard = bytes.fromhex(guard_hex)
+        require(bytes_at(pe, image, address, len(guard)) == guard,
+                f"entry guard changed: {name}")
+    for address, guard_hex in AUX.items():
+        guard = bytes.fromhex(guard_hex)
+        require(bytes_at(pe, image, address, len(guard)) == guard,
+                f"auxiliary ABI/call guard changed: 0x{address:08X}")
+    caller_targets = {
+        0x004C3120, 0x004C2C70, 0x004C2D50, 0x004E2EF0, 0x00495960,
+        *BYPASS_CALLERS.keys(),
+    }
+    calls = direct_call_map(pe, caller_targets)
+    require(calls[0x004C3120] == CLEANUP_CALLERS,
+            "transfer zero-cleanup caller set changed")
+    require(calls[0x004C2C70] == STOCK_ADD_CORE_CALLERS,
+            "stock-add core caller set changed")
+    require(calls[0x004C2D50] == STOCK_REMOVE_CORE_CALLERS,
+            "stock-remove core caller set changed")
+    require(calls[0x004E2EF0] == SERIALIZER_CALLERS,
+            "serializer caller set changed")
+    require(calls[0x00495960] == ACTOR_INITIALIZE_CALLERS,
+            "actor-initialize caller set changed")
+    require(direct_call_map(pe, {0x004E3090})[0x004E3090] == MAIN_CONTROLLER_CALLERS,
+            "main-menu controller caller set changed")
+    require(POST_COMMIT_ACTOR_INIT_RETURN == 0x0048B97B + 5,
+            "post-commit actor return seam changed")
+    transfer_calls = set()
+    for start, end in (
+        (0x004F5E30, 0x004F5FA0), (0x004F5FA0, 0x004F6030),
+        (0x004F6030, 0x004F6140), (0x004F6140, 0x004F6300),
+        (0x004F6300, 0x004F65E1),
+    ):
+        transfer_calls |= call_targets_in_range(pe, image, start, end)
+    require(transfer_calls == {
+        0x004BE790, 0x004BFC90, 0x004BFCF0, 0x004C2C70,
+        0x004C2D50, 0x004C2ED0, 0x004C2FA0, 0x004C3120,
+    }, "transfer family gained an unowned external side effect")
+    redistribution_calls = (
+        call_targets_in_range(pe, image, 0x0056DB20, 0x0056DB50) |
+        call_targets_in_range(pe, image, 0x0056DB50, 0x0056DCDC)
+    )
+    require(redistribution_calls == {0x0047E410, 0x0047E450},
+            "redistribution family gained an unowned external side effect")
+    for target, callers in BYPASS_CALLERS.items():
+        require(calls[target] == callers,
+                f"bypassed family caller set changed: 0x{target:08X}")
+    transfer_caller_sites = set().union(*(
+        callers for target, callers in BYPASS_CALLERS.items()
+        if target not in {0x0056DB20, 0x0056DB50}
+    ))
+    for call in transfer_caller_sites:
+        require(bytes_at(pe, image, call + 5, 2) == b"\x83\xC4",
+                "transfer caller is no longer caller-clean cdecl")
+    for call in BYPASS_CALLERS[0x0056DB20] | BYPASS_CALLERS[0x0056DB50]:
+        require(bytes_at(pe, image, call + 5, 5)[:1] == b"\xB8",
+                "redistribution caller started using the bypass return")
+    pe.close()
+
+
+def mutation_test(runtime: str, data: str, header: str, opengl: str,
+                  config: str, issue_stub: str) -> int:
+    rejected = 0
+    mutants: list[tuple] = []
+    for hook in HOOKS:
+        mutants.append((runtime.replace(f"add(HookId::{hook},", "add(HookId::removed_", 1),
+                        data, header, opengl))
+    for hook, (address, guard_hex) in HOOKS.items():
+        start = runtime.index(f"add(HookId::{hook},")
+        end = runtime.index(");", start)
+        segment = runtime[start:end]
+        first = f"0x{bytes.fromhex(guard_hex)[0]:02X}"
+        mutated_segment = segment.replace(first, "0x00", 1)
+        mutants.append((runtime[:start] + mutated_segment + runtime[end:],
+                        data, header, opengl))
+        mutants.append((runtime,
+                        data.replace(f"0x{address:08X}", "0x00000000", 1),
+                        header, opengl))
+    for _address, guard_hex in AUX.items():
+        guard = bytes.fromhex(guard_hex)
+        literal = ",".join(f"0x{byte:02X}" for byte in guard)
+        compact = re.sub(r"\s+", "", runtime)
+        if literal in compact:
+            pattern = r"\s*,\s*".join(
+                re.escape(f"0x{byte:02X}") for byte in guard[:2])
+            mutated, count = re.subn(pattern, "0x00,0x00", runtime, count=1)
+            require(count == 1, "auxiliary mutation target is absent")
+            mutants.append((mutated, data, header, opengl))
+    rollback_start = runtime.index("bool rollback_patches(")
+    rollback_end = runtime.index("bool install_hooks()")
+    rollback_source = runtime[rollback_start:rollback_end]
+    install_start = rollback_end
+    install_end = runtime.index("} // namespace", install_start)
+    install_source = runtime[install_start:install_end]
+    write_line = "std::memcpy(site.address, site.replacement.data(), site.length);"
+    protect_line = "if (!set_pages_writable(pages, page_count)) {"
+    early_write = install_source.replace(protect_line, write_line + "\n    " + protect_line, 1)
+    rollback_no_restore = rollback_source.replace(
+        "restored = restore_page_protections(pages, page_count) && restored;", "", 1)
+    install_no_restore = install_source.replace(
+        "if (!restore_page_protections(pages, page_count)) {", "if (false) {", 1)
+    warning_start = runtime.index("bool update_warning_modal()")
+    warning_end = runtime.index("bool is_private_transaction_hook", warning_start)
+    warning_source = runtime[warning_start:warning_end]
+    foreign_start = warning_source.index(
+        "if (*ff8_externals.shared_magic_dialog_active != 0)")
+    foreign_return = warning_source.index("return false;", foreign_start)
+    warning_foreign_owned = (warning_source[:foreign_return] + "return true;" +
+                             warning_source[foreign_return + len("return false;"):])
+    safe_clear = (
+        "g_warning = MergeError::none;\n"
+        "        g_warning_started = false;\n"
+        "        if (*ff8_externals.shared_magic_dialog_active != 0) {\n"
+        "            clear();\n"
+        "        }"
+    )
+    recursive_clear = (
+        "if (*ff8_externals.shared_magic_dialog_active != 0) {\n"
+        "            clear();\n"
+        "        }\n"
+        "        g_warning = MergeError::none;\n"
+        "        g_warning_started = false;"
+    )
+    diagnostic_records = (
+        'append_runtime_log("init requested=0 installedFunctions=0 installedCalls=0\\n");',
+        'append_runtime_log("failure reason=preflight-failed installedFunctions=0 installedCalls=0\\n");',
+        'append_runtime_log("failure reason=transactional-install-failed installedFunctions=0 installedCalls=0\\n");',
+    )
+    for record in diagnostic_records:
+        mutants.append((runtime.replace(record, "", 1), data, header, opengl))
+        record_position = runtime.index(record)
+        return_position = runtime.index("return false;", record_position)
+        reordered = (runtime[:record_position] +
+                     runtime[record_position + len(record):return_position + len("return false;")] +
+                     "\n        " + record + runtime[return_position + len("return false;"):])
+        mutants.append((reordered, data, header, opengl))
+    mutants.extend([
+        (runtime.replace("bool g_warning_started = false;",
+                         "bool g_warning_started = true;", 1),
+         data, header, opengl),
+        (runtime.replace("if (g_warning_updating) {", "if (false) {", 1),
+         data, header, opengl),
+        (runtime.replace("bool g_requested = false;", "bool g_requested = true;", 1),
+         data, header, opengl),
+        (runtime.replace("std::to_string(static_cast<unsigned int>(g_stock_limit))",
+                         'std::string("100")', 1), data, header, opengl),
+        (runtime.replace("!verify_hook_guards() ||", "true ||", 1),
+         data, header, opengl),
+        (runtime.replace("request_activation();", "", 1), data, header, opengl),
+        (runtime.replace("frame.internal = g_internal_depth != 0;", "", 1),
+         data, header, opengl),
+        (runtime.replace("if (!g_actor_ready[actor])", "if (false)", 1),
+         data, header, opengl),
+        (runtime.replace("begin_canonical_save", "removed_begin_save", 1),
+         data, header, opengl),
+        (runtime.replace("suspend_for_private_scenario", "removed_suspend", 1),
+         data, header, opengl),
+        (runtime.replace(EXE_SHA256, EXE_SHA256.upper(), 1),
+         data, header, opengl),
+        (runtime.replace("shared_magic_serializer_call_2", "removed_serializer_call"),
+         data, header, opengl),
+        (runtime.replace("{ff8_externals.shared_magic_serializer_call_2,",
+                         "{ff8_externals.shared_magic_serializer_call_1,", 1),
+         data, header, opengl),
+        (runtime.replace("g_private_character_snapshot", "removed_character_snapshot"),
+         data, header, opengl),
+        (runtime.replace("is_reconciliation_owner(frame.id)", "false", 1),
+         data, header, opengl),
+        (runtime.replace("frame.nested_owned_writer = true;", "", 1),
+         data, header, opengl),
+        (runtime.replace("shared_magic_post_commit_actor_init_return", "removed_post_commit_return", 1),
+         data, header, opengl),
+        (runtime.replace("(initial_battle_setup || battle_rematerialization)", "true", 1),
+         data, header, opengl),
+        (runtime.replace("changed_results_match", "removed_match"),
+         data, header, opengl),
+        (runtime.replace("issue51_should_bypass", "removed_bypass"),
+         data, header, opengl),
+        (runtime[:warning_start] + warning_foreign_owned + runtime[warning_end:],
+         data, header, opengl),
+        (runtime.replace(safe_clear, recursive_clear, 1), data, header, opengl),
+        (runtime.replace("*ff8_externals.shared_magic_dialog_active != 0", "false", 1),
+         data, header, opengl),
+        (runtime.replace("if (!exact_restore ||", "if (false ||", 1),
+         data, header, opengl),
+        (runtime.replace("for (const auto &[address, replacement] : calls)",
+                         "if (false)", 1), data, header, opengl),
+        (runtime[:install_start] + early_write + runtime[install_end:],
+         data, header, opengl),
+        (runtime[:rollback_start] + rollback_no_restore + runtime[rollback_end:],
+         data, header, opengl),
+        (runtime[:install_start] + install_no_restore + runtime[install_end:],
+         data, header, opengl),
+        (runtime.replace("hard_stop_unproved_patch_state(\"patch write rollback failed\");",
+                         "return false;", 1), data, header, opengl),
+        (runtime.replace("if (g_first_failure.empty()) {\n        g_first_failure = reason;\n    }",
+                         "g_first_failure = reason;", 1), data, header, opengl),
+        (runtime.replace("if (!g_requested && !g_installed && !g_install_failed &&\n"
+                         "        g_heartbeat_sequence != 0) {\n        return;\n    }",
+                         "", 1), data, header, opengl),
+        (runtime.replace("FlushInstructionCache(GetCurrentProcess(), nullptr, 0)",
+                         "true", 1), data, header, opengl),
+        (runtime.replace("g_canonical_snapshot_valid && ff8_externals.savemap != nullptr",
+                         "true && ff8_externals.savemap != nullptr", 1),
+         data, header, opengl),
+        (runtime.replace("if (!set_pages_writable(pages, page_count)) {\n        return false;",
+                         "set_pages_writable(pages, page_count);", 1),
+         data, header, opengl),
+        (runtime.replace("base=c056db2783f376a340fcefa6a48cc33618998876",
+                         "base=wrong", 1), data, header, opengl),
+        (runtime, data, header, opengl, None,
+         config.replace('name != "schemaVersion" && name != "sharedMagicInventory" &&',
+                        "false", 1), issue_stub),
+        (runtime, data, header, opengl,
+         COMMON.read_text(encoding="utf-8").replace(
+             "lexeditor::ff8::shared_magic::apply_gameplay_config(",
+             "lexeditor::ff8::shared_magic::apply_removed_config(", 1)),
+        (runtime, data, header, opengl,
+         COMMON.read_text(encoding="utf-8").replace(
+             "if (ff8) ff8_shared_magic_heartbeat();", "", 1)),
+        (runtime, data, header, opengl,
+         COMMON.read_text(encoding="utf-8").replace(
+             "static constexpr char version_suffix[] = \" \" VERSION;\n"
+             "\t\t\tstatic_assert(sizeof(version_suffix) <= sizeof(newWindowTitle),\n"
+             "\t\t\t\t\"The complete FFNx version suffix must fit in the window title\");\n"
+             "\t\t\tstrncat_s(newWindowTitle, sizeof(newWindowTitle), version_suffix, _TRUNCATE);",
+             "char tmp[16];\n"
+             "\t\t\tsprintf_s(tmp, 16, \" \" VERSION);\n"
+             "\t\t\tstrcat_s(newWindowTitle, 1024, tmp);", 1)),
+        (runtime.replace("return g_installed ? kCompleteHookCount : 0U;",
+                         "return kCompleteHookCount;", 1),
+         data, header, opengl),
+        (runtime, data, header, opengl, None, config,
+         issue_stub.replace("return lexeditor_ff8_shared_magic_requested();",
+                            "return 0U;", 1)),
+        (runtime, data, header, opengl, None, config,
+         issue_stub.replace("return lexeditor_ff8_shared_magic_runtime_identity();",
+                            "return nullptr;", 1)),
+        (runtime, data, header, opengl, None, config,
+         issue_stub.replace("constexpr std::uint32_t kIssue51HookCount = 28;",
+                            "constexpr std::uint32_t kIssue51HookCount = 27;", 1)),
+        (runtime, data, header, opengl, None, config,
+         issue_stub.replace("lexeditor_issue_51_config_version()",
+                            "removed_config_version()", 1)),
+    ])
+    survivors = []
+    for index, mutant in enumerate(mutants):
+        try:
+            check_sources(*mutant)
+        except (AssertionError, ValueError):
+            rejected += 1
+        else:
+            survivors.append(index)
+    require(rejected == len(mutants),
+            f"mutation coverage incomplete: {rejected}/{len(mutants)}; survivors={survivors}")
+    return rejected
+
+
+def main() -> int:
+    runtime = RUNTIME.read_text(encoding="utf-8")
+    data = DATA.read_text(encoding="utf-8")
+    header = HEADER.read_text(encoding="utf-8")
+    opengl = OPENGL.read_text(encoding="utf-8")
+    config = CONFIG.read_text(encoding="utf-8")
+    issue_stub = ISSUE_STUB.read_text(encoding="utf-8")
+    check_sources(runtime, data, header, opengl, None, config, issue_stub)
+    hext = HEXT.read_text(encoding="utf-8")
+    sort_token = "std::sort(entries.begin(), entries.end()"
+    require(sort_token in hext, "Hext files are not sorted before application")
+    apply_all = hext[hext.index("void Hext::applyAll("):]
+    require(
+        apply_all.index(sort_token) < apply_all.index("if (!checkpoint.empty())")
+        and apply_all.count("for (const auto& entry : entries)") == 2
+        and "filename().generic_string()" in apply_all,
+        "normal and delayed Hext paths do not share one lexical filename order",
+    )
+    executable = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_EXE
+    if executable.is_file():
+        check_executable(executable)
+    rejected = mutation_test(runtime, data, header, opengl, config, issue_stub)
+    try:
+        require(sort_token in hext.replace(sort_token, "removed_sort(", 1),
+                "Hext sort removal survived")
+    except AssertionError:
+        rejected += 1
+    print(f"issue #51 shared-Magic runtime: PASS ({rejected} source mutations rejected)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
