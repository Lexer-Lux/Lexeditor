+std::string sha256(const std::filesystem::path &path)
+{
+    std::string digest;
+    CryptoPP::SHA256 hash;
+    CryptoPP::FileSource source(path.string().c_str(), true,
+        new CryptoPP::HashFilter(hash,
+            new CryptoPP::HexEncoder(new CryptoPP::StringSink(digest), false)));
+    return lower_ascii(digest);
+}
+
+Target parse_target(const Json &value, const std::filesystem::path &direct_root,
+                    std::unordered_map<std::string, std::string> &verified)
+{
+    member(value, "mode", Json::Kind::string);
+    const bool has_pass = value.object.contains("passThrough");
+    const bool has_asset = value.object.contains("asset") || value.object.contains("sha256");
+    if (has_pass == has_asset) throw std::runtime_error("Target must be pass-through or an asset");
+    if (has_pass) {
+        if (!member(value, "passThrough", Json::Kind::boolean).boolean) {
+            throw std::runtime_error("passThrough must be true");
+        }
+        return {};
+    }
+    const std::string relative = member(value, "asset", Json::Kind::string).string;
+    const std::string digest = lower_ascii(member(value, "sha256", Json::Kind::string).string);
+    if (digest.size() != 64 || !std::all_of(digest.begin(), digest.end(), [](unsigned char value) {
+            return std::isxdigit(value) != 0;
+        }) || !safe_relative(relative, kAssetPrefix)) {
+        throw std::runtime_error("Conditional asset identity is invalid");
+    }
+    const std::filesystem::path filename = std::filesystem::path(relative).filename();
+    if (!lower_ascii(filename.string()).starts_with(digest.substr(0, 24))) {
+        throw std::runtime_error("Conditional asset filename does not match its hash");
+    }
+    const std::filesystem::path candidate = std::filesystem::weakly_canonical(direct_root / relative);
+    const std::filesystem::path allowed = std::filesystem::weakly_canonical(direct_root / "lexeditor" / "conditional-variants");
+    std::error_code file_error;
+    if (!path_below(candidate, allowed) || !std::filesystem::is_regular_file(candidate, file_error) || file_error) {
+        throw std::runtime_error("Conditional asset is missing or escapes its root");
+    }
+    const std::string candidate_key = lower_ascii(candidate.string());
+    const auto existing = verified.find(candidate_key);
+    if (existing != verified.end()) {
+        if (existing->second != digest) throw std::runtime_error("One asset has multiple digests");
+    } else {
+        if (sha256(candidate) != digest) throw std::runtime_error("Conditional asset hash does not match");
+        verified.emplace(candidate_key, digest);
+    }
+    Target output; output.pass_through = false; output.asset = candidate; return output;
+}
+
+Token parse_token(const Json &value)
+{
+    const std::string operation = lower_ascii(member(value, "op", Json::Kind::string).string);
+    Token token{};
+    if (operation == "var") {
+        exact_keys(value, {"op", "spec", "values"});
+        token.operation = Token::Operation::variable;
+        token.spec = member(value, "spec", Json::Kind::string).string;
+        token.values = member(value, "values", Json::Kind::string).string;
+        if (token.spec.empty() || token.values.empty()) throw std::runtime_error("Runtime variable is empty");
+        return token;
+    }
+    exact_keys(value, {"op", "arity"});
+    const std::int64_t arity = member(value, "arity", Json::Kind::integer).integer;
+    if (arity <= 0 || arity > static_cast<std::int64_t>(kMaxTokensPerCondition)) {
+        throw std::runtime_error("Runtime operation arity is invalid");
+    }
+    token.arity = static_cast<std::size_t>(arity);
+    if (operation == "not" && token.arity == 1) token.operation = Token::Operation::logical_not;
+    else if (operation == "and") token.operation = Token::Operation::logical_and;
+    else if (operation == "or") token.operation = Token::Operation::logical_or;
+    else throw std::runtime_error("Runtime operation is unsupported");
+    return token;
+}
+
+std::unique_ptr<Database> load(const std::filesystem::path &direct_root)
+{
+    const std::filesystem::path manifest = direct_root / kManifestRelative;
+    std::error_code size_error;
+    const std::uintmax_t size = std::filesystem::file_size(manifest, size_error);
+    if (size_error || size == 0 || size > kMaxManifestBytes) return {};
+    std::ifstream stream(manifest, std::ios::binary);
+    if (!stream) return {};
+    std::string source(static_cast<std::size_t>(size), '\0');
+    stream.read(source.data(), static_cast<std::streamsize>(source.size()));
+    if (!stream || stream.gcount() != static_cast<std::streamsize>(source.size())) return {};
+    Json root = JsonParser(std::move(source)).parse();
+    exact_keys(root, {"schemaVersion", "liveConditionalRoutes"});
+    if (member(root, "schemaVersion", Json::Kind::integer).integer != 1) return {};
+    const Json &route_values = member(root, "liveConditionalRoutes", Json::Kind::array);
+    if (route_values.array.size() > kMaxRoutes) return {};
+    auto database = std::make_unique<Database>();
+    database->direct_root = std::filesystem::weakly_canonical(direct_root);
+    std::unordered_map<std::string, std::string> verified;
+    std::size_t total_variants = 0;
+    for (const Json &value : route_values.array) {
+        try {
+            exact_keys(value, {"routeVersion", "logicalPath", "status", "outcomeEncoding",
+                               "conditions", "variants", "fallback"}, {"rejected"});
+            if (member(value, "routeVersion", Json::Kind::integer).integer != 1 ||
+                member(value, "status", Json::Kind::string).string != "ready: final variants precomposed" ||
+                member(value, "outcomeEncoding", Json::Kind::string).string !=
+                    "condition-id bitmask, least-significant bit first") continue;
+            const std::string logical = lower_ascii(member(value, "logicalPath", Json::Kind::string).string);
+            const std::string root_name = logical.substr(0, logical.find('/'));
+            if (!safe_relative(logical, root_name + "/") ||
+                (root_name != "direct" && root_name != "sfx" && root_name != "voice" && root_name != "ambient")) continue;
+            Route route;
+            const Json &condition_values = member(value, "conditions", Json::Kind::array);
+            if (condition_values.array.size() > kMaxConditionsPerRoute) continue;
+            for (std::size_t id = 0; id < condition_values.array.size(); ++id) {
+                const Json &condition_value = condition_values.array[id];
+                exact_keys(condition_value, {"id", "program"});
+                if (member(condition_value, "id", Json::Kind::integer).integer != static_cast<std::int64_t>(id)) {
+                    throw std::runtime_error("Condition IDs are not contiguous");
+                }
+                const Json &program = member(condition_value, "program", Json::Kind::array);
+                if (program.array.empty() || program.array.size() > kMaxTokensPerCondition) {
+                    throw std::runtime_error("Condition program size is invalid");
+                }
+                std::vector<Expression> stack;
+                for (const Json &token_value : program.array) {
+                    Token token = parse_token(token_value);
+                    Expression expression; expression.token = std::move(token);
+                    if (expression.token.operation != Token::Operation::variable) {
+                        if (expression.token.arity > stack.size()) {
+                            throw std::runtime_error("Postfix condition underflows");
+                        }
+                        const std::size_t first = stack.size() - expression.token.arity;
+                        for (std::size_t index = first; index < stack.size(); ++index) {
+                            expression.children.push_back(std::move(stack[index]));
+                        }
+                        stack.resize(first);
+                    }
+                    stack.push_back(std::move(expression));
+                }
+                if (stack.size() != 1) throw std::runtime_error("Postfix condition has extra values");
+                Condition condition; condition.root = std::move(stack.front());
+                route.conditions.push_back(std::move(condition));
+            }
+            const Json &variant_values = member(value, "variants", Json::Kind::array);
+            const std::size_t expected = std::size_t{1} << route.conditions.size();
+            if (variant_values.array.size() != expected || expected > kMaxVariantsPerRoute ||
+                total_variants + expected > kMaxVariantsTotal) continue;
+            for (const Json &variant_value : variant_values.array) {
+                exact_keys(variant_value, {"outcome", "mode", "sources"},
+                           {"conflicts", "passThrough", "asset", "sha256"});
+                const std::int64_t outcome = member(variant_value, "outcome", Json::Kind::integer).integer;
+                if (outcome < 0 || static_cast<std::size_t>(outcome) >= expected) {
+                    throw std::runtime_error("Variant outcome is out of range");
+                }
+                member(variant_value, "sources", Json::Kind::array);
+                if (!route.variants.emplace(static_cast<std::uint32_t>(outcome),
+                        parse_target(variant_value, database->direct_root, verified)).second) {
+                    throw std::runtime_error("Variant outcome is duplicated");
+                }
+            }
+            if (route.variants.size() != expected) throw std::runtime_error("Variant outcome is missing");
+            const Json &fallback_value = member(value, "fallback", Json::Kind::object);
+            exact_keys(fallback_value, {"mode"},
+                       {"conflicts", "passThrough", "asset", "sha256"});
+            route.fallback = parse_target(fallback_value,
+                                          database->direct_root, verified);
+            if (!database->routes.emplace(logical, std::move(route)).second) {
+                throw std::runtime_error("Logical route is duplicated");
+            }
+            total_variants += expected;
+        } catch (...) {
+            // A malformed route is inert. Other independently valid routes
+            // remain usable, and normal FFNx lookup is its fallback.
+        }
+    }
+    return database;
+}
+
+std::mutex state_mutex;
+std::unique_ptr<Database> database;
+std::filesystem::path loaded_root;
+bool load_attempted = false;
+
+} // namespace
+
+bool resolve(const std::filesystem::path &direct_root, std::string_view logical_path,
+             std::filesystem::path &selected) noexcept
+{
+    try {
+        std::lock_guard lock(state_mutex);
+        const std::filesystem::path canonical_root = std::filesystem::weakly_canonical(direct_root);
+        if (!load_attempted || canonical_root != loaded_root) {
+            database.reset();
+            loaded_root = canonical_root;
+            load_attempted = true;
+            try { database = load(canonical_root); }
+            catch (...) { database.reset(); }
+        }
+        if (!database) return false;
+        std::string logical(logical_path);
+        std::replace(logical.begin(), logical.end(), '\\', '/');
+        logical = lower_ascii(std::move(logical));
+        const auto found = database->routes.find(logical);
+        if (found == database->routes.end()) return false;
+        Route &route = found->second;
+        std::uint32_t outcome = 0;
+        bool valid = true;
+        for (std::size_t id = 0; id < route.conditions.size(); ++id) {
+            bool active = false;
+            if (!evaluate(*database, route.conditions[id], active)) { valid = false; break; }
+            if (active) outcome |= std::uint32_t{1} << id;
+        }
+        const Target *target = &route.fallback;
+        if (valid) {
+            const auto variant = route.variants.find(outcome);
+            if (variant != route.variants.end()) target = &variant->second;
+        }
+        if (target->pass_through) return false;
+        selected = target->asset;
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+void reset_for_tests() noexcept
+{
+    std::lock_guard lock(state_mutex);
+    database.reset(); loaded_root.clear(); load_attempted = false;
+}
+
+} // namespace lexeditor::ff8::live_conditions
