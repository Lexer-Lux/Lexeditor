+void append_runtime_log(const char *line)
+{
+    const std::filesystem::path path =
+        std::filesystem::path(basedir) / "FFNx.shared-magic.log";
+    WIN32_FILE_ATTRIBUTE_DATA attributes{};
+    if (GetFileAttributesExA(path.string().c_str(), GetFileExInfoStandard,
+                             &attributes)) {
+        const ULONGLONG size =
+            (static_cast<ULONGLONG>(attributes.nFileSizeHigh) << 32) |
+            attributes.nFileSizeLow;
+        if (size > 4ULL * 1024ULL * 1024ULL) {
+            const std::filesystem::path previous = path.string() + ".1";
+            MoveFileExA(path.string().c_str(), previous.string().c_str(),
+                        MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+        }
+    }
+    FILE *stream = nullptr;
+    if (fopen_s(&stream, path.string().c_str(), "ab") != 0 || stream == nullptr) {
+        return;
+    }
+    std::fputs(line, stream);
+    std::fflush(stream);
+    const HANDLE handle = reinterpret_cast<HANDLE>(_get_osfhandle(_fileno(stream)));
+    if (handle != INVALID_HANDLE_VALUE) {
+        FlushFileBuffers(handle);
+    }
+    std::fclose(stream);
+}
