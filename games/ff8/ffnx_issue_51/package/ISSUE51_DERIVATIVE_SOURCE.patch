+
+class JsonParser final {
+public:
+    explicit JsonParser(std::string source) : source_(std::move(source)) {}
+
+    Json parse()
+    {
+        Json result = value(0);
+        whitespace();
+        if (position_ != source_.size()) {
+            throw std::runtime_error("JSON has trailing data");
+        }
+        return result;
+    }
+
+private:
+    std::string source_;
+    std::size_t position_ = 0;
+    std::size_t nodes_ = 0;
+
+    void whitespace()
+    {
+        while (position_ < source_.size() &&
+               std::isspace(static_cast<unsigned char>(source_[position_]))) {
+            ++position_;
+        }
+    }
+
+    char take()
+    {
+        if (position_ >= source_.size()) {
+            throw std::runtime_error("Unexpected end of JSON");
+        }
+        return source_[position_++];
+    }
+
+    void literal(const char *text)
+    {
+        while (*text != '\0') {
+            if (take() != *text++) {
+                throw std::runtime_error("Invalid JSON literal");
+            }
+        }
+    }
+
+    static void append_utf8(std::string &output, std::uint32_t value)
+    {
+        if (value <= 0x7FU) {
+            output.push_back(static_cast<char>(value));
+        } else if (value <= 0x7FFU) {
+            output.push_back(static_cast<char>(0xC0U | (value >> 6)));
+            output.push_back(static_cast<char>(0x80U | (value & 0x3FU)));
+        } else if (value <= 0xFFFFU) {
+            output.push_back(static_cast<char>(0xE0U | (value >> 12)));
+            output.push_back(static_cast<char>(0x80U | ((value >> 6) & 0x3FU)));
+            output.push_back(static_cast<char>(0x80U | (value & 0x3FU)));
+        } else {
+            output.push_back(static_cast<char>(0xF0U | (value >> 18)));
+            output.push_back(static_cast<char>(0x80U | ((value >> 12) & 0x3FU)));
+            output.push_back(static_cast<char>(0x80U | ((value >> 6) & 0x3FU)));
+            output.push_back(static_cast<char>(0x80U | (value & 0x3FU)));
+        }
+    }
+
+    std::uint32_t hex4()
+    {
+        std::uint32_t result = 0;
+        for (int index = 0; index < 4; ++index) {
+            const char digit = take();
+            result <<= 4;
+            if (digit >= '0' && digit <= '9') result |= digit - '0';
+            else if (digit >= 'a' && digit <= 'f') result |= digit - 'a' + 10;
+            else if (digit >= 'A' && digit <= 'F') result |= digit - 'A' + 10;
+            else throw std::runtime_error("Invalid JSON Unicode escape");
+        }
+        return result;
+    }
+
+    std::string string()
+    {
+        if (take() != '"') throw std::runtime_error("JSON string is missing a quote");
+        std::string output;
+        while (true) {
+            const unsigned char value = static_cast<unsigned char>(take());
+            if (value == '"') break;
+            if (value < 0x20U) throw std::runtime_error("JSON string has a control byte");
+            if (value != '\\') {
+                output.push_back(static_cast<char>(value));
+                continue;
+            }
+            switch (take()) {
+            case '"': output.push_back('"'); break;
+            case '\\': output.push_back('\\'); break;
+            case '/': output.push_back('/'); break;
+            case 'b': output.push_back('\b'); break;
+            case 'f': output.push_back('\f'); break;
+            case 'n': output.push_back('\n'); break;
+            case 'r': output.push_back('\r'); break;
+            case 't': output.push_back('\t'); break;
+            case 'u': {
+                std::uint32_t codepoint = hex4();
+                if (codepoint >= 0xD800U && codepoint <= 0xDBFFU) {
+                    if (take() != '\\' || take() != 'u') {
+                        throw std::runtime_error("JSON high surrogate has no pair");
+                    }
+                    const std::uint32_t low = hex4();
+                    if (low < 0xDC00U || low > 0xDFFFU) {
+                        throw std::runtime_error("JSON surrogate pair is invalid");
+                    }
+                    codepoint = 0x10000U + ((codepoint - 0xD800U) << 10)
+                        + (low - 0xDC00U);
+                } else if (codepoint >= 0xDC00U && codepoint <= 0xDFFFU) {
+                    throw std::runtime_error("JSON has an unpaired low surrogate");
+                }
+                append_utf8(output, codepoint);
+                break;
+            }
+            default: throw std::runtime_error("JSON escape is invalid");
+            }
+        }
+        return output;
+    }
+
+    Json number()
+    {
+        const std::size_t start = position_;
+        if (source_[position_] == '-') ++position_;
+        if (position_ >= source_.size() || !std::isdigit(
+                static_cast<unsigned char>(source_[position_]))) {
+            throw std::runtime_error("JSON number is invalid");
+        }
+        if (source_[position_] == '0') {
+            ++position_;
+        } else {
+            while (position_ < source_.size() && std::isdigit(
+                    static_cast<unsigned char>(source_[position_]))) ++position_;
+        }
+        if (position_ < source_.size() &&
+            (source_[position_] == '.' || source_[position_] == 'e' ||
+             source_[position_] == 'E')) {
+            throw std::runtime_error("Live-condition JSON accepts integers only");
+        }
+        Json result;
+        result.kind = Json::Kind::integer;
+        try {
+            result.integer = std::stoll(source_.substr(start, position_ - start));
+        } catch (...) {
+            throw std::runtime_error("JSON integer is out of range");
+        }
+        return result;
+    }
+
+    Json value(std::size_t depth)
+    {
+        if (depth > kMaxJsonDepth || ++nodes_ > kMaxJsonNodes) {
+            throw std::runtime_error("JSON complexity limit exceeded");
+        }
+        whitespace();
+        if (position_ >= source_.size()) throw std::runtime_error("JSON value is missing");
+        const char first = source_[position_];
+        if (first == '"') {
+            Json result; result.kind = Json::Kind::string; result.string = string(); return result;
+        }
+        if (first == '-' || std::isdigit(static_cast<unsigned char>(first))) return number();
+        if (first == 'n') { literal("null"); return {}; }
+        if (first == 't') { literal("true"); Json result; result.kind = Json::Kind::boolean; result.boolean = true; return result; }
+        if (first == 'f') { literal("false"); Json result; result.kind = Json::Kind::boolean; return result; }
+        if (first == '[') {
+            take(); Json result; result.kind = Json::Kind::array; whitespace();
+            if (position_ < source_.size() && source_[position_] == ']') { ++position_; return result; }
+            while (true) {
+                result.array.push_back(value(depth + 1)); whitespace();
+                const char separator = take();
+                if (separator == ']') break;
+                if (separator != ',') throw std::runtime_error("JSON array separator is invalid");
+            }
+            return result;
+        }
+        if (first == '{') {
+            take(); Json result; result.kind = Json::Kind::object; whitespace();
+            if (position_ < source_.size() && source_[position_] == '}') { ++position_; return result; }
+            while (true) {
+                whitespace();
+                if (position_ >= source_.size() || source_[position_] != '"') {
+                    throw std::runtime_error("JSON object key is invalid");
+                }
+                std::string key = string(); whitespace();
+                if (take() != ':') throw std::runtime_error("JSON object has no colon");
+                if (!result.object.emplace(std::move(key), value(depth + 1)).second) {
+                    throw std::runtime_error("JSON object has a duplicate key");
+                }
+                whitespace();
+                const char separator = take();
+                if (separator == '}') break;
+                if (separator != ',') throw std::runtime_error("JSON object separator is invalid");
+            }
+            return result;
+        }
+        throw std::runtime_error("JSON value is invalid");
+    }
+};
+
+const Json &member(const Json &object, const char *name, Json::Kind kind)
+{
+    if (object.kind != Json::Kind::object) throw std::runtime_error("Expected JSON object");
+    const auto found = object.object.find(name);
+    if (found == object.object.end() || found->second.kind != kind) {
+        throw std::runtime_error(std::string("Invalid or missing JSON field: ") + name);
+    }
+    return found->second;
+}
