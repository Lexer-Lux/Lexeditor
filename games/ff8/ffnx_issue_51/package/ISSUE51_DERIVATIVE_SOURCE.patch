+bool prepare_hook_code()
+{
+    constexpr std::size_t kBlockSize = 128;
+    auto *code = static_cast<std::uint8_t *>(VirtualAlloc(
+        nullptr, kBlockSize * g_hooks.size(), MEM_COMMIT | MEM_RESERVE,
+        PAGE_EXECUTE_READWRITE));
+    if (code == nullptr) {
+        ffnx_error("Shared Magic: executable hook allocation failed.\n");
+        return false;
+    }
+
+    for (std::size_t index = 0; index < g_hooks.size(); ++index) {
+        HookSpec &hook = g_hooks[index];
+        hook.stub = code + index * kBlockSize;
+        hook.trampoline = hook.stub + 64;
+
+        std::memcpy(hook.trampoline,
+                    reinterpret_cast<const void *>(*hook.address),
+                    hook.patch_length);
+        write_relative(hook.trampoline + hook.patch_length, 0xE9,
+                       reinterpret_cast<const void *>(*hook.address + hook.patch_length));
+
+        // Transfer and redistribution helpers are true no-ops in shared mode:
+        // they are cdecl functions, their callers clean the stack, zero means
+        // no transfer, and redistribution callers ignore EAX. Other hooks run
+        // the original complete transaction and reconcile only on return.
+        std::uint8_t *stub = hook.stub;
+        stub[0] = 0x9C;
+        stub[1] = 0x60;
+        stub[2] = 0x68;
+        *reinterpret_cast<std::uint32_t *>(stub + 3) =
+            static_cast<std::uint32_t>(hook.id);
+        write_relative(stub + 7, 0xE8,
+                       reinterpret_cast<const void *>(&issue51_should_bypass));
+        stub[12] = 0x83; stub[13] = 0xC4; stub[14] = 0x04;
+        stub[15] = 0x85; stub[16] = 0xC0;
+        stub[17] = 0x74; stub[18] = 0x05;
+        stub[19] = 0x61;
+        stub[20] = 0x9D;
+        stub[21] = 0x33; stub[22] = 0xC0;
+        stub[23] = 0xC3;
+        stub[24] = 0x68;
+        *reinterpret_cast<std::uint32_t *>(stub + 25) =
+            static_cast<std::uint32_t>(hook.id);
+        stub[29] = 0x8D; stub[30] = 0x44; stub[31] = 0x24; stub[32] = 0x28;
+        stub[33] = 0x50;
+        write_relative(stub + 34, 0xE8,
+                       reinterpret_cast<const void *>(&issue51_before));
+        stub[39] = 0x83; stub[40] = 0xC4; stub[41] = 0x08;
+        stub[42] = 0x61;
+        stub[43] = 0x9D;
+        write_relative(stub + 44, 0xE9, hook.trampoline);
+    }
+    return true;
+}
