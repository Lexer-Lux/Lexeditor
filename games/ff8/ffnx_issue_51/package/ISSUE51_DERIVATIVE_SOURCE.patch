+		{
+			uint32_t diff = (POPUP_TTL_MAX - popup_ttl) / 10;
+
+			if(diff == 0) popup_ttl--;
+			else if(diff > popup_ttl) popup_ttl = 0;
+			else popup_ttl -= diff;
+		}
+	}
