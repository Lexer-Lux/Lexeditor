diff --git a/src/overlay.cpp b/src/overlay.cpp
index b2cc508..b922155 100644
--- a/src/overlay.cpp
+++ b/src/overlay.cpp
@@ -28,6 +28,7 @@
 #include "cfg.h"
 #include "world.h"
 #include "lighting_debug.h"
+#include "lexeditor_ff8_bars.h"
 
 #define IMGUI_VIEW_ID 255
 
@@ -218,6 +219,9 @@ void Overlay::Render(ImDrawData* drawData)
 bool Overlay::init(bgfx::ProgramHandle program, int width, int height)
 {
     mem_edit.Open = false;
+    // The status bars share ImGui's renderer, but they must not make FFNx's
+    // developer window visible. Only the explicit DevTools setting owns it.
+    visible = enable_devtools;
 
