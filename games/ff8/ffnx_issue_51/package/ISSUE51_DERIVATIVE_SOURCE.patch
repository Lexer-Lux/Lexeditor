+++ b/src/lexeditor_ff8_bars.cpp
@@ -0,0 +1,542 @@
+#include "lexeditor_ff8_bars.h"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
