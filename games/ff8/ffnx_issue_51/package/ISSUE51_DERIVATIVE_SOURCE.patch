+extern "C" void __declspec(naked) issue51_post_thunk()
+{
+    __asm {
+        sub esp, 4
+        pushfd
+        pushad
+        call issue51_after
+        mov [esp + 36], eax
+        popad
+        popfd
+        ret
+    }
+}
