+/****************************************************************************/
+// Lexeditor shared party Magic for FF8 1.2 US-English Nvidia.
+// This file is part of the GPL-3.0-or-later FFNx derivative.
+/****************************************************************************/
+
+#include "shared_magic_runtime.h"
+#include "../lexeditor_ff8_shared_party.h"
+
+#include "lexeditor_shared_magic_core.h"
+
+#include "../ff8.h"
+#include "../cfg.h"
+#include "../globals.h"
+#include "../log.h"
+#include "../common.h"
+#include "../lexeditor_ff8_toast.h"
+#include "../common.h"
+
+#include <windows.h>
+#include <io.h>
+
+#include <cryptopp/files.h>
+#include <cryptopp/filters.h>
+#include <cryptopp/hex.h>
+#include <cryptopp/sha.h>
+
+#include <array>
