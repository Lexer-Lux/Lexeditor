+}
+$after | Export-Csv -LiteralPath (Join-Path $sourceRoot "game-root-after.csv") -NoTypeInformation -Encoding utf8
+if (Compare-Object $before $after -Property Relative, Length, LastWriteUtc) { throw "The FF8 game-root file manifest changed during the build." }
+
+$beforeHashes = Import-Csv -LiteralPath (Join-Path $sourceRoot "game-root-top-level-hashes-before.csv")
+$afterHashes = Get-ChildItem -LiteralPath $gameRootPath -Force -File | Sort-Object Name | Get-FileHash -Algorithm SHA256 | Select-Object Path, Hash
+$afterHashes | Export-Csv -LiteralPath (Join-Path $sourceRoot "game-root-top-level-hashes-after.csv") -NoTypeInformation -Encoding utf8
+if (Compare-Object $beforeHashes $afterHashes -Property Path, Hash) { throw "A top-level FF8 game-root file hash changed during the build." }
+
+$artifactHash = Get-FileHash -LiteralPath $artifactPath -Algorithm SHA256
+[pscustomobject]@{
+    Artifact = $artifactHash.Path; Sha256 = $artifactHash.Hash; Bytes = $bytes.Length
+    PeMachine = "0x{0:X4}" -f $machine; PeType = "PE32"; Identity = $identity
+    ConfigIdentity = $configIdentity; FunctionHooks = 28; CallSitePatches = 4
+    TotalPatchSites = 32; GameRootFilesCompared = $after.Count; GameRootChangedFiles = 0
+} | Format-List
