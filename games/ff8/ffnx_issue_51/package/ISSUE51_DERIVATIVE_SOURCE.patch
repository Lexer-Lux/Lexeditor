+extern "C" void __declspec(noinline) __cdecl issue51_before(
+    std::uintptr_t *return_slot, const std::uint32_t raw_id)
+{
+    if (g_frame_depth >= g_frames.size()) {
+        fail_closed_to_canonical("hook nesting limit reached");
+        return;
+    }
+    HookFrame &frame = g_frames[g_frame_depth++];
+    frame = {};
+    frame.id = static_cast<HookId>(raw_id);
+    frame.original_return = *return_slot;
+    frame.argument1 = static_cast<std::uint32_t>(return_slot[1]);
+    frame.argument2 = static_cast<std::uint32_t>(return_slot[2]);
+    before_original(frame);
+    *return_slot = reinterpret_cast<std::uintptr_t>(&issue51_post_thunk);
+}
+
+extern "C" std::uintptr_t __declspec(noinline) __cdecl issue51_after()
+{
+    if (g_frame_depth == 0) {
+        fail_closed_to_canonical("unmatched hook return");
+        return 0;
+    }
+    const HookFrame frame = g_frames[--g_frame_depth];
+    after_original(frame);
+    return frame.original_return;
+}
