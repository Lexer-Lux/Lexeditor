+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <limits>
+#include <cstdio>
+#include <string>
+#include <utility>
+
+namespace {
+
+using namespace lexeditor::ff8::shared_magic;
+
+constexpr char kSupportedExeSha256[] =
+    "064d466b5fe2ba901fd44abf19f37c0fd6a2db40aabd95c9e5959195b6589570";
+constexpr std::size_t kActorCount = 3;
+constexpr std::size_t kActorStride = 0x1D0;
+constexpr std::size_t kActorMagicOffset = 0x82;
+constexpr std::size_t kActorMagicStride = 5;
+constexpr std::size_t kMaxFrames = 32;
+constexpr std::uint32_t kCompleteHookCount = 28;
+constexpr char kRuntimeIdentity[] =
+    "Lexeditor issue 51 shared magic core; "
+    "base=c056db2783f376a340fcefa6a48cc33618998876; runtime=on; hooks=28";
+constexpr char kConfigContractIdentity[] =
+    "Lexeditor issue 51 config: "
+    "<basedir>/<direct_mode_path>/lexeditor/gameplay.toml; "
+    "schemaVersion=1; sharedMagicInventory=bool; magicStockLimit=int[1,255]; "
+    "missing=false; invalid=false; unknown=false";
+
+static_assert(sizeof(savemap_ff8_character) == 0x98,
+              "reviewed character stride changed");
+static_assert(offsetof(savemap_ff8_character, magics) == 0x10,
+              "reviewed Magic offset changed");
+static_assert(sizeof(MagicSlot) == 2, "reviewed Magic slot changed");
+
+enum class HookId : std::uint32_t {
+    startup_initializer,
+    script_initializer,
+    field_add,
+    actor_mutator,
+    battle_to_save,
+    actor_clear,
+    actor_initialize,
+    held_validator,
+    stock_add,
+    stock_remove,
+    stock_add_core,
+    stock_remove_core,
+    transfer_zero_cleanup,
+    scenario_enter,
+    scenario_exit,
+    character_swap,
+    reorder,
+    menu_controller,
+    transfer_begin,
+    transfer_compare,
+    transfer_move,
+    transfer_swap,
+    transfer_finish,
+    battle_list_controller,
+    draw_transaction,
+    redistribution_copy,
+    redistribution_sum,
+    main_menu_controller,
+    count,
+};
+
+struct HookSpec {
+    HookId id;
+    const char *name;
+    std::uint32_t *address;
+    std::array<std::uint8_t, 16> guard;
+    std::uint8_t patch_length;
+    std::uint8_t *stub = nullptr;
+    std::uint8_t *trampoline = nullptr;
+};
+
+using ActorInventories = std::array<MagicInventory, kActorCount>;
+using CharacterSnapshots = std::array<savemap_ff8_character, kCharacterCount>;
+
+struct HookFrame {
+    HookId id{};
+    std::uintptr_t original_return = 0;
+    PrivateInventories saved_before{};
+    ActorInventories actors_before{};
+    bool internal = false;
+    bool battle_magic_callback = false;
+    bool private_transaction_member = false;
+    bool nested_owned_writer = false;
+    bool reconciliation_owner = false;
+    std::uint32_t argument1 = 0;
+    std::uint32_t argument2 = 0;
+};
+
+bool g_requested = false;
+std::uint8_t g_stock_limit = kDefaultStockLimit;
+bool g_installed = false;
+bool g_install_failed = false;
+RuntimeState g_state{};
+bool g_canonical_snapshot_valid = false;
+MergeError g_warning = MergeError::none;
+std::string g_activation_toast;
+// Lexeditor's own in-game messages go to the FF8-style box in
+// lexeditor_ff8_toast.cpp, which owns the queue and the drawing.
+bool g_warning_started = false;
+bool g_warning_updating = false;
+std::uint32_t g_internal_depth = 0;
+thread_local std::array<HookFrame, kMaxFrames> g_frames{};
+thread_local std::size_t g_frame_depth = 0;
+std::array<bool, kActorCount> g_actor_ready{};
+std::uint32_t g_private_transaction_depth = 0;
+MagicInventory g_private_transaction_snapshot{};
+CharacterSnapshots g_private_character_snapshot{};
+std::uint32_t g_reconciliation_owner_depth = 0;
+std::array<std::uint64_t, kCompleteHookCount> g_function_hits{};
+std::array<std::uint64_t, 4> g_call_site_hits{};
+std::uint64_t g_function_hit_total = 0;
+std::uint64_t g_call_site_hit_total = 0;
+std::uint64_t g_activation_attempts = 0, g_activation_successes = 0;
+std::uint64_t g_reconcile_attempts = 0, g_reconcile_successes = 0;
+std::uint64_t g_save_attempts = 0, g_save_successes = 0;
+std::uint64_t g_heartbeat_sequence = 0;
+ULONGLONG g_last_heartbeat_tick = 0;
+bool g_launch_logged = false;
+std::string g_config_path;
+std::string g_first_failure;
+
+void append_runtime_log(const char *line)
+{
+    const std::filesystem::path path =
+        std::filesystem::path(basedir) / "FFNx.shared-magic.log";
+    WIN32_FILE_ATTRIBUTE_DATA attributes{};
+    if (GetFileAttributesExA(path.string().c_str(), GetFileExInfoStandard,
+                             &attributes)) {
+        const ULONGLONG size =
+            (static_cast<ULONGLONG>(attributes.nFileSizeHigh) << 32) |
+            attributes.nFileSizeLow;
+        if (size > 4ULL * 1024ULL * 1024ULL) {
+            const std::filesystem::path previous = path.string() + ".1";
+            MoveFileExA(path.string().c_str(), previous.string().c_str(),
+                        MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+        }
+    }
+    FILE *stream = nullptr;
+    if (fopen_s(&stream, path.string().c_str(), "ab") != 0 || stream == nullptr) {
+        return;
+    }
+    std::fputs(line, stream);
+    std::fflush(stream);
+    const HANDLE handle = reinterpret_cast<HANDLE>(_get_osfhandle(_fileno(stream)));
+    if (handle != INVALID_HANDLE_VALUE) {
+        FlushFileBuffers(handle);
+    }
+    std::fclose(stream);
+}
+
+void log_launch_once()
+{
+    if (g_launch_logged) {
+        return;
+    }
+    g_launch_logged = true;
+    SYSTEMTIME now{};
+    GetSystemTime(&now);
+    char line[1024]{};
+    std::snprintf(line, sizeof(line),
+        "--- launch pid=%lu utc=%04u-%02u-%02uT%02u:%02u:%02uZ exeSha256=%s config=%s ---\n",
+        GetCurrentProcessId(), now.wYear, now.wMonth, now.wDay, now.wHour,
+        now.wMinute, now.wSecond, kSupportedExeSha256,
