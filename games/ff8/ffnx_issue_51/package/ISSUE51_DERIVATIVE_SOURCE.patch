diff --git a/src/reptile_atb_runtime.h b/src/reptile_atb_runtime.h
new file mode 100644
index 0000000..c3c89a0
--- /dev/null
+++ b/src/reptile_atb_runtime.h
@@ -0,0 +1,72 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+
+namespace lexeditor_reptile_atb {
+constexpr std::uint8_t kFireElement = 0x01;
+constexpr std::uint8_t kIceElement = 0x02;
+constexpr double kIceMultiplier = 0.92;
+constexpr double kFireMultiplier = 1.08;
+constexpr unsigned kFirstEnemySlot = 3;
+constexpr unsigned kLastEnemySlot = 10;
+constexpr unsigned kEnemySlots = 8;
+
+inline int enemy_index(unsigned battle_slot) {
+    return battle_slot >= kFirstEnemySlot && battle_slot <= kLastEnemySlot
+        ? static_cast<int>(battle_slot - kFirstEnemySlot) : -1;
+}
+
+inline int com_id(unsigned battle_slot, std::uint8_t scene_entity_id) {
+    if (enemy_index(battle_slot) < 0 || scene_entity_id < 0x10) return -1;
+    return static_cast<int>(scene_entity_id) - 0x10;
+}
+
+struct SpeedState {
+    double multiplier[kEnemySlots]{};
+    double remainder[kEnemySlots]{};
+
+    SpeedState() { reset(); }
+
+    void reset() {
+        for (unsigned i = 0; i < kEnemySlots; ++i) {
+            multiplier[i] = 1.0;
+            remainder[i] = 0.0;
+        }
+    }
+
+    bool apply(unsigned battle_slot, std::uint8_t element_mask) {
+        const int index = enemy_index(battle_slot);
+        if (index < 0) return false;
+        bool changed = false;
+        if (element_mask & kIceElement) {
+            multiplier[index] *= kIceMultiplier;
+            changed = true;
+        }
+        if (element_mask & kFireElement) {
+            multiplier[index] *= kFireMultiplier;
+            changed = true;
+        }
+        return changed;
+    }
+
+    std::uint32_t scale_increment(unsigned battle_slot, std::uint32_t native_increment) {
+        const int index = enemy_index(battle_slot);
+        if (index < 0 || native_increment == 0) return native_increment;
+        const double value = static_cast<double>(native_increment) * multiplier[index] + remainder[index];
+        const double limit = static_cast<double>(std::numeric_limits<std::uint32_t>::max());
+        if (value >= limit) {
+            remainder[index] = 0.0;
+            return std::numeric_limits<std::uint32_t>::max();
+        }
+        // Decimal rates such as 0.92 are not exactly representable in binary.
+        // Snap values that are only floating-point epsilon below the next
+        // integer so 1000 frames at 0.92 really total 920 native ATB ticks.
+        const double nonnegative = std::max(0.0, value);
+        const double whole = std::floor(nonnegative + 1e-9);
+        remainder[index] = std::max(0.0, nonnegative - whole);
+        return static_cast<std::uint32_t>(whole);
+    }
+};
+} // namespace lexeditor_reptile_atb
diff --git a/src/toast_layout.h b/src/toast_layout.h
new file mode 100644
index 0000000..db3b403
--- /dev/null
+++ b/src/toast_layout.h
@@ -0,0 +1,70 @@
+#pragma once
+// Where a Lexeditor toast sits on screen, and how it fades.
+//
+// Separated from the drawing for the same reason the queue is: this part can
+// be reasoned about and tested without a device, a frame, or a running game.
+// Everything here is in the game's own pixels - FF8 renders at a fixed size
+// and the renderer projects those coordinates onto the window - so a box laid
+// out here lands in the same place whatever the window is doing.
+
+#include <algorithm>
+#include <cstddef>
+
+namespace lexeditor_toast {
+
+// FF8's own message boxes sit a little above the bottom edge, indented from
+// both sides, and are padded inside by about one character.
+constexpr float BOTTOM_MARGIN = 0.08f;   // of the game's height
+constexpr float SIDE_MARGIN = 0.06f;     // of the game's width
+constexpr float PADDING_CHARS = 1.0f;
+constexpr float PADDING_LINES = 0.5f;
+// The last fraction of the hold fades out, and the first fraction fades in, so
+// a message never appears or vanishes between one frame and the next.
+constexpr float FADE_IN = 0.05f;
+constexpr float FADE_OUT = 0.12f;
+
+struct Metrics {
+    float width = 640.0f;        // the game's own frame, in its own pixels
+    float height = 480.0f;
+    float line_height = 20.0f;   // one line of text
+    float char_width = 9.0f;     // one character at that size
+};
+
+struct Box {
+    float x = 0.0f, y = 0.0f, width = 0.0f, height = 0.0f;
+    float text_x = 0.0f, text_y = 0.0f;
+};
+
+// Size the box to the text, then place it bottom-centre. A box wider than the
+// frame allows is clamped rather than allowed to hang off the edge, which is
+// the case a long sentence in a small window produces.
+inline Box layout(const Metrics &metrics, std::size_t lines, std::size_t columns)
+{
+    const float padding_x = metrics.char_width * PADDING_CHARS;
+    const float padding_y = metrics.line_height * PADDING_LINES;
+    const float limit = metrics.width * (1.0f - 2.0f * SIDE_MARGIN);
+    Box box;
+    box.width = std::min(limit,
+        static_cast<float>(columns) * metrics.char_width + 2.0f * padding_x);
+    box.height = static_cast<float>(lines ? lines : 1) * metrics.line_height
+        + 2.0f * padding_y;
+    box.x = (metrics.width - box.width) * 0.5f;
+    box.y = metrics.height * (1.0f - BOTTOM_MARGIN) - box.height;
+    if (box.y < 0.0f) box.y = 0.0f;
+    box.text_x = box.x + padding_x;
+    box.text_y = box.y + padding_y;
+    return box;
+}
+
+// Opacity from 0 to 1 for a message that is `progress` of the way through its
+// hold. Flat in the middle: the point of the queue was that a sentence stays
+// readable, so only the ends move.
+inline float fade(float progress)
+{
+    progress = std::clamp(progress, 0.0f, 1.0f);
+    if (progress < FADE_IN) return progress / FADE_IN;
+    if (progress > 1.0f - FADE_OUT) return (1.0f - progress) / FADE_OUT;
+    return 1.0f;
+}
+
+}  // namespace lexeditor_toast
diff --git a/src/vehicle_drive.h b/src/vehicle_drive.h
new file mode 100644
index 0000000..c79e739
--- /dev/null
+++ b/src/vehicle_drive.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace lexeditor_vehicle_drive {
+// FF8's remapped 16-bit pad mask (PSX layout as used by World_HandleInputs).
+constexpr std::uint32_t kL2 = 0x0001u;
+constexpr std::uint32_t kR2 = 0x0002u;
+constexpr std::uint32_t kTriangle = 0x0010u;
+constexpr std::uint32_t kSquare = 0x0080u;
+
+inline bool supported_state(unsigned state) {
+    return state == 0x30u || state == 0x32u || state == 0x84u ||
+        (state >= 0x20u && state <= 0x28u);
+}
+
+// FF8's world rY is centered at 128. Native World_HandleInputs converts a high
+// raw value into negative/full forward movement and a low raw value into
+// positive/reverse movement. RT is forward, LT is reverse. L2/R2 logical keys
+// are digital fallbacks, so keyboard users get the same controls.
+inline int axis(float left_trigger, float right_trigger,
+                bool left_digital = false, bool right_digital = false) {
+    float left = std::isfinite(left_trigger) ? std::clamp(left_trigger, 0.0f, 1.0f) : 0.0f;
+    float right = std::isfinite(right_trigger) ? std::clamp(right_trigger, 0.0f, 1.0f) : 0.0f;
+    // A physical trigger can also set its logical L2/R2 bit. Do not let that
+    // alias turn a partial trigger pull into full throttle. Digital-only
+    // keyboard input still supplies the complete axis range.
+    if (left_digital && left == 0.0f) left = 1.0f;
+    if (right_digital && right == 0.0f) right = 1.0f;
+    const float drive = right - left;
+    if (std::abs(drive) < 0.02f) return 128;
+    const float scale = drive > 0.0f ? 127.0f : 128.0f;
+    return std::clamp(128 + static_cast<int>(std::lround(drive * scale)), 0, 255);
+}
+} // namespace lexeditor_vehicle_drive
diff --git a/tests/lexeditor_live_conditions_test.cpp b/tests/lexeditor_live_conditions_test.cpp
new file mode 100644
index 0000000..814b00d
--- /dev/null
+++ b/tests/lexeditor_live_conditions_test.cpp
@@ -0,0 +1,201 @@
+#include "ff8/lexeditor_live_conditions.h"
+
+#include <windows.h>
+#include <cryptopp/files.h>
+#include <cryptopp/filters.h>
+#include <cryptopp/hex.h>
+#include <cryptopp/sha.h>
+
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace live = lexeditor::ff8::live_conditions;
+
+void check(bool value, const char *message)
+{
+    if (!value) throw std::runtime_error(message);
+}
+
+std::string digest(const std::filesystem::path &path)
+{
+    std::string output;
+    CryptoPP::SHA256 hash;
+    CryptoPP::FileSource source(path.string().c_str(), true,
+        new CryptoPP::HashFilter(hash,
+            new CryptoPP::HexEncoder(new CryptoPP::StringSink(output), false)));
+    return output;
+}
+
+std::string address(const void *pointer)
+{
+    std::ostringstream output;
+    output << "0x" << std::hex << reinterpret_cast<std::uintptr_t>(pointer);
+    return output.str();
+}
+
+std::string target(const std::string &relative, const std::string &sha,
+                   bool variant)
+{
+    return std::string("{\"mode\":\"opaque winner\",") +
+        (variant ? "\"sources\":[]," : "") +
+        "\"asset\":\"" + relative + "\",\"sha256\":\"" + sha + "\"}";
+}
+
+std::string condition(const std::vector<std::string> &tokens)
+{
+    std::string output = "{\"id\":0,\"program\":[";
+    for (std::size_t index = 0; index < tokens.size(); ++index) {
+        if (index) output += ',';
+        output += tokens[index];
+    }
+    return output + "]}";
+}
+
+std::string variable(const std::string &spec, const std::string &values)
+{
+    return "{\"op\":\"var\",\"spec\":\"" + spec +
+           "\",\"values\":\"" + values + "\"}";
+}
+
+std::string route(const std::string &logical, const std::string &program,
+                  const std::string &off_target, const std::string &on_target,
+                  const std::string &fallback_target)
+{
+    return "{\"routeVersion\":1,\"logicalPath\":\"" + logical +
+        "\",\"status\":\"ready: final variants precomposed\"," 
+        "\"outcomeEncoding\":\"condition-id bitmask, least-significant bit first\"," 
+        "\"conditions\":[" + program + "],\"variants\":["
+        "{\"outcome\":0," + off_target.substr(1) + ","
+        "{\"outcome\":1," + on_target.substr(1) + "],"
+        "\"fallback\":" + fallback_target + "}";
+}
+
+int main()
+{
+    const std::filesystem::path root = std::filesystem::temp_directory_path() /
+        ("lexeditor-live-condition-test-" + std::to_string(GetCurrentProcessId()));
+    std::filesystem::remove_all(root);
+    const std::filesystem::path assets = root / "lexeditor" / "conditional-variants";
+    std::filesystem::create_directories(assets);
+    const std::filesystem::path off_file = assets / "off.bin";
+    const std::filesystem::path on_file = assets / "on.bin";
+    const std::filesystem::path fallback_file = assets / "fallback.bin";
+    { std::ofstream(off_file, std::ios::binary) << "OFF"; }
+    { std::ofstream(on_file, std::ios::binary) << "ON"; }
+    { std::ofstream(fallback_file, std::ios::binary) << "FALLBACK"; }
+    const std::string off_sha = digest(off_file), on_sha = digest(on_file), fallback_sha = digest(fallback_file);
+    const auto rename_hashed = [&](const std::filesystem::path &old, const std::string &sha) {
+        const std::filesystem::path moved = old.parent_path() / (sha.substr(0, 24) + ".bin");
+        std::filesystem::rename(old, moved); return moved;
+    };
+    const std::filesystem::path off_hashed = rename_hashed(off_file, off_sha);
+    const std::filesystem::path on_hashed = rename_hashed(on_file, on_sha);
+    const std::filesystem::path fallback_hashed = rename_hashed(fallback_file, fallback_sha);
+    const auto relative = [&](const std::filesystem::path &path) {
+        return path.lexically_relative(root).generic_string();
+    };
+    const std::string off = target(relative(off_hashed), off_sha, true);
+    const std::string on = target(relative(on_hashed), on_sha, true);
+    const std::string fallback = target(relative(fallback_hashed), fallback_sha, false);
+
+    std::uint8_t byte_value = 7;
+    std::int16_t short_value = -123;
+    std::int32_t int_value = 0x12345678;
+    std::uint8_t ff_string[] = {40, 37, 44, 44, 47, 0xFF}; // HELLO
+    SYSTEMTIME now{}; GetLocalTime(&now);
+
+    const std::string memory_program = condition({
+        variable("Byte:" + address(&byte_value), "7"),
+        variable("Short:" + address(&short_value), "-123"),
+        "{\"op\":\"and\",\"arity\":2}",
+        variable("Int:" + address(&int_value) + ":0xFF", "120"),
+        "{\"op\":\"and\",\"arity\":2}",
+        variable("FFString:" + address(ff_string) + ":6", "hello"),
+        "{\"op\":\"and\",\"arity\":2}",
+    });
+    const std::string invalid_program = condition({variable("Byte:0x1", "1")});
+    const std::string short_circuit_program = condition({
+        variable("Sys:Hour", std::to_string(now.wHour)),
+        variable("Byte:0x1", "1"),
+        "{\"op\":\"or\",\"arity\":2}",
+    });
+    const std::string counter_program = condition({variable("CounterAdv:pages:2", "1")});
+    const std::vector<std::pair<std::string, std::string>> routes = {
+        {"direct/memory.bin", memory_program},
+        {"direct/invalid.bin", invalid_program},
+        {"direct/short-circuit.bin", short_circuit_program},
+        {"direct/counter.bin", counter_program},
+        {"sfx/random.ogg", condition({variable("Random:dice:1", "0")})},
+        {"voice/counter-random.ogg", condition({variable("CounterRnd:dice:1", "0")})},
+        {"ambient/once.ogg", condition({variable("RandomVarOnce:voice:1", "0")})},
+        {"direct/lifetime.bin", condition({variable("RandomVar:lifetime:1:0", "0")})},
+    };
+    std::string document = "{\"schemaVersion\":1,\"liveConditionalRoutes\":[";
+    for (std::size_t index = 0; index < routes.size(); ++index) {
+        if (index) document += ',';
+        document += route(routes[index].first, routes[index].second, off, on, fallback);
+    }
+    document += "]}";
+    std::filesystem::create_directories(root / "lexeditor");
+    { std::ofstream(root / "lexeditor" / "live-conditions.json", std::ios::binary) << document; }
+
+    std::filesystem::path selected;
+    check(live::resolve(root, "direct/memory.bin", selected) && selected == on_hashed,
+          "guarded memory types did not select the precomposed true asset");
+    check(live::resolve(root, "direct/invalid.bin", selected) && selected == fallback_hashed,
+          "an unreadable memory condition did not fail closed to its fallback");
+    check(live::resolve(root, "direct/short-circuit.bin", selected) && selected == on_hashed,
+          "OR did not short-circuit before an unreadable memory condition");
+    check(live::resolve(root, "direct/counter.bin", selected) && selected == on_hashed,
+          "CounterAdv did not advance on its first evaluation");
+    check(live::resolve(root, "direct/counter.bin", selected) && selected == off_hashed,
+          "CounterAdv did not preserve state across lookups");
+    for (const char *logical : {"sfx/random.ogg", "voice/counter-random.ogg",
+                                "ambient/once.ogg", "direct/lifetime.bin"}) {
+        check(live::resolve(root, logical, selected) && selected == on_hashed,
+              "a supported runtime root or state variable did not select its final asset");
+    }
+    check(!live::resolve(root, "direct/not-present.bin", selected),
+          "an unknown logical path did not pass through to normal FFNx lookup");
+
+    // One malformed route is inert and cannot disable a separate valid route.
+    live::reset_for_tests();
+    const std::string malformed =
+        "{\"routeVersion\":1,\"logicalPath\":\"direct/malformed.bin\"," 
+        "\"status\":\"ready: final variants precomposed\"," 
+        "\"outcomeEncoding\":\"condition-id bitmask, least-significant bit first\"," 
+        "\"conditions\":[" + invalid_program + "],\"variants\":["
+        "{\"outcome\":0," + off.substr(1) + ","
+        "{\"outcome\":0," + on.substr(1) + "],\"fallback\":" + fallback + "}";
+    const std::string isolated = "{\"schemaVersion\":1,\"liveConditionalRoutes\":[" +
+        route("direct/memory.bin", memory_program, off, on, fallback) + "," + malformed + "]}";
+    { std::ofstream(root / "lexeditor" / "live-conditions.json", std::ios::binary | std::ios::trunc) << isolated; }
+    check(live::resolve(root, "direct/memory.bin", selected) && selected == on_hashed,
+          "one malformed route disabled an independent valid route");
+    check(!live::resolve(root, "direct/malformed.bin", selected),
+          "a malformed route was not inert");
+
+    // A malformed root disables the evaluator and leaves normal FFNx lookup in control.
+    live::reset_for_tests();
+    { std::ofstream(root / "lexeditor" / "live-conditions.json", std::ios::binary | std::ios::trunc)
+        << "{\"schemaVersion\":1,\"liveConditionalRoutes\":[],\"unknown\":true}"; }
+    check(!live::resolve(root, "direct/memory.bin", selected),
+          "a malformed root manifest did not fail closed");
+
+    // Asset integrity is checked when the manifest loads. A changed final file
+    // makes each route that names it inert instead of serving the changed data.
+    live::reset_for_tests();
+    { std::ofstream(root / "lexeditor" / "live-conditions.json", std::ios::binary | std::ios::trunc) << document; }
+    { std::ofstream(on_hashed, std::ios::binary | std::ios::trunc) << "ALTERED"; }
+    check(!live::resolve(root, "direct/memory.bin", selected),
+          "a changed final asset was selected without its declared hash");
+
+    live::reset_for_tests();
+    std::filesystem::remove_all(root);
+    return 0;
+}
diff --git a/tests/lexeditor_shared_magic_config_test.cpp b/tests/lexeditor_shared_magic_config_test.cpp
new file mode 100644
index 0000000..0d19684
--- /dev/null
+++ b/tests/lexeditor_shared_magic_config_test.cpp
@@ -0,0 +1,168 @@
+#include "ff8/lexeditor_shared_magic_config.h"
+
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+using namespace lexeditor::ff8::shared_magic;
+
+namespace {
+
+bool sink_value = false;
+int sink_calls = 0;
+std::uint8_t limit_value = 0;
+int limit_calls = 0;
+
+void capture_request(const bool requested)
+{
+    sink_value = requested;
+    ++sink_calls;
+}
+
+void capture_limit(const std::uint8_t value)
+{
+    limit_value = value;
+    ++limit_calls;
+}
+
+void reset_sink()
+{
+    sink_value = false;
+    sink_calls = 0;
+    limit_value = 0;
+    limit_calls = 0;
+}
+
+void write_config(const std::filesystem::path &root, const std::string &text)
+{
+    const auto directory = root / "lexeditor";
+    std::filesystem::create_directories(directory);
+    std::ofstream output(directory / "gameplay.toml", std::ios::binary);
+    output << text;
+    output.close();
+    assert(output.good());
+}
+
+void reset_root(const std::filesystem::path &root)
+{
+    std::error_code error;
+    std::filesystem::remove_all(root, error);
+    assert(!error);
+    std::filesystem::create_directories(root);
+}
+
+void expect_disabled(const GameplayConfigResult &result,
+                     const GameplayConfigStatus status)
+{
+    static int check = 0;
+    ++check;
+    if (result) {
+        std::fprintf(stderr, "disabled check %d unexpectedly valid\n", check);
+        std::exit(1);
+    }
+    if (result.status != status) {
+        std::fprintf(stderr, "expected status %d, got %d\n",
+                     static_cast<int>(status), static_cast<int>(result.status));
+        std::exit(1);
+    }
+    assert(result.status == status);
+    assert(!result.shared_magic_inventory);
+    assert(result.magic_stock_limit == 100);
+}
+
+} // namespace
+
+int main()
+{
+    const auto root = std::filesystem::temp_directory_path() /
+        "ffnx-lexeditor-issue51-config-test";
+    reset_root(root);
+
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::missing);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory = true\nmagicStockLimit = 255\n");
+    reset_sink();
+    auto result = apply_gameplay_config(root, capture_request, capture_limit);
+    assert(result);
+    assert(result.shared_magic_inventory);
+    assert(sink_calls == 1 && sink_value);
+    assert(limit_calls == 1 && limit_value == 255);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory = false\nmagicStockLimit = 1\n");
+    reset_sink();
+    result = apply_gameplay_config(root, capture_request, capture_limit);
+    assert(result);
+    assert(!result.shared_magic_inventory);
+    assert(sink_calls == 1 && !sink_value);
+    assert(limit_calls == 1 && limit_value == 1);
+
+    write_config(root,
+                 "schemaVersion = 1\nsharedMagicInventory = true\nmagicStockLimit = 100\nextra = false\n");
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::unknown_key);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory = true\nmagicStockLimit = 100\n[unexpected]\nenabled = true\n");
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::unknown_key);
+
+    write_config(root, "sharedMagicInventory = true\n");
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::missing_key);
+
+    write_config(root, "schemaVersion = 1\n");
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::missing_key);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory = true\n");
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::missing_key);
+
+    for (const char *value : {"0", "256", "true", "1.5"}) {
+        write_config(root, std::string("schemaVersion = 1\nsharedMagicInventory = true\nmagicStockLimit = ") + value + "\n");
+        expect_disabled(load_gameplay_config(root),
+                        GameplayConfigStatus::invalid_magic_stock_limit);
+    }
+
+    write_config(root, "schemaVersion = 2\nsharedMagicInventory = true\nmagicStockLimit = 100\n");
+    expect_disabled(load_gameplay_config(root),
+                    GameplayConfigStatus::invalid_schema_version);
+
+    write_config(root, "schemaVersion = \"1\"\nsharedMagicInventory = true\nmagicStockLimit = 100\n");
+    expect_disabled(load_gameplay_config(root),
+                    GameplayConfigStatus::invalid_schema_version);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory = 1\nmagicStockLimit = 100\n");
+    expect_disabled(load_gameplay_config(root),
+                    GameplayConfigStatus::invalid_shared_magic_type);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory =\n");
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::malformed);
+
+    std::string invalid_utf8 =
+        "schemaVersion = 1\nsharedMagicInventory = true\n# ";
+    invalid_utf8.push_back(static_cast<char>(0xC3));
+    invalid_utf8.push_back(static_cast<char>(0x28));
+    write_config(root, invalid_utf8);
+    expect_disabled(load_gameplay_config(root), GameplayConfigStatus::malformed);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory =\n");
+
+    reset_sink();
+    result = apply_gameplay_config(root, capture_request, capture_limit);
+    assert(!result);
+    assert(sink_calls == 1 && !sink_value);
+
+    reset_root(root);
+    reset_sink();
+    result = apply_gameplay_config(root, capture_request, capture_limit);
+    assert(!result);
+    assert(result.status == GameplayConfigStatus::missing);
+    assert(sink_calls == 1 && !sink_value);
+
+    write_config(root, "schemaVersion = 1\nsharedMagicInventory = true\nmagicStockLimit = 100\n");
+    reset_sink();
+    result = apply_gameplay_config(root, nullptr, nullptr);
+    assert(result && result.shared_magic_inventory);
+    assert(sink_calls == 0);
+
+    std::filesystem::remove_all(root);
+    return 0;
+}
diff --git a/tools/verify_issue51_runtime_artifact.py b/tools/verify_issue51_runtime_artifact.py
new file mode 100644
index 0000000..a552552
--- /dev/null
+++ b/tools/verify_issue51_runtime_artifact.py
@@ -0,0 +1,193 @@
+"""Verify the linked issue-51 FFNx runtime without loading it."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import shutil
+import struct
+import sys
+import tempfile
+
+import pefile
+
+
+SOURCE_COMMIT = "c056db2783f376a340fcefa6a48cc33618998876"
+HOOK_COUNT = 28
+IDENTITY = (
+    "Lexeditor issue 51 shared magic core; "
+    f"base={SOURCE_COMMIT}; runtime=on; hooks={HOOK_COUNT}"
+)
+CONFIG_IDENTITY = (
+    "Lexeditor issue 51 config: "
+    "<basedir>/<direct_mode_path>/lexeditor/gameplay.toml; "
+    "schemaVersion=1; sharedMagicInventory=bool; magicStockLimit=int[1,255]; "
+    "missing=false; invalid=false; unknown=false"
+)
+REQUIRED_EXPORTS = {
+    "new_dll_graphics_driver",
+    "lexeditor_issue_51_identity",
+    "lexeditor_issue_51_hook_count",
+    "lexeditor_issue_51_runtime_requested",
+    "lexeditor_issue_51_compile_gate_enabled",
+    "lexeditor_issue_51_config_contract",
+    "lexeditor_issue_51_core_linked",
+    "lexeditor_issue_51_config_version",
+    "lexeditor_ff8_shared_magic_compiled_hook_count",
+    "lexeditor_ff8_shared_magic_compiled_call_site_count",
+    "lexeditor_ff8_shared_magic_compiled_patch_site_count",
+}
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise AssertionError(message)
+
+
+class LinkedRuntime:
+    def __init__(self, path: Path):
+        self.path = path
+        self.data = path.read_bytes()
+        self.pe = pefile.PE(data=self.data, fast_load=False)
+        require(self.pe.FILE_HEADER.Machine == 0x014C, "driver is not x86")
+        require(self.pe.OPTIONAL_HEADER.Magic == 0x010B, "driver is not PE32")
+        require(hasattr(self.pe, "DIRECTORY_ENTRY_EXPORT"), "driver has no exports")
+        self.image_base = self.pe.OPTIONAL_HEADER.ImageBase
+        self.exports: dict[str, int] = {}
+        for symbol in self.pe.DIRECTORY_ENTRY_EXPORT.symbols:
+            if symbol.name is None:
+                continue
+            name = symbol.name.decode("ascii", errors="strict")
+            require(symbol.forwarder is None, f"forwarded export: {name}")
+            self.exports[name] = symbol.address
+
+    def file_offset(self, rva: int) -> int:
+        return self.pe.get_offset_from_rva(rva)
+
+    def function_offset(self, name: str) -> int:
+        require(name in self.exports, f"missing export: {name}")
+        rva = self.exports[name]
+        for _ in range(4):
+            offset = self.file_offset(rva)
+            while self.data[offset] in {0x90, 0xCC}:
+                offset += 1
+                rva += 1
+            if self.data[offset] == 0xE9:
+                relative = struct.unpack_from("<i", self.data, offset + 1)[0]
+                rva += 5 + relative
+                continue
+            if self.data[offset] == 0xEB:
+                relative = struct.unpack_from("<b", self.data, offset + 1)[0]
+                rva += 2 + relative
+                continue
+            return offset
+        raise AssertionError(f"too many export thunks: {name}")
+
+    def constant(self, name: str, *, boolean: bool = False) -> int | None:
+        offset = self.function_offset(name)
+        if boolean and self.data[offset:offset + 3] == b"\xB0\x01\xC3":
+            return 1
+        if self.data[offset:offset + 3] == b"\x33\xC0\xC3":
+            return 0
+        if (self.data[offset:offset + 1] == b"\xB8" and
+                self.data[offset + 5:offset + 6] == b"\xC3"):
+            return struct.unpack_from("<I", self.data, offset + 1)[0]
+        return None
+
+    def returned_string(self, name: str) -> str:
+        address = self.constant(name)
+        require(address is not None, f"string export is not a fixed pointer: {name}")
+        rva = address - self.image_base
+        require(0 <= rva < self.pe.OPTIONAL_HEADER.SizeOfImage,
+                f"string export points outside image: {name}")
+        offset = self.file_offset(rva)
+        end = self.data.find(b"\0", offset, offset + 1024)
+        require(end >= 0, f"string export is unterminated: {name}")
+        return self.data[offset:end].decode("ascii", errors="strict")
+
+
+def verify(path: Path) -> LinkedRuntime:
+    runtime = LinkedRuntime(path)
+    require(REQUIRED_EXPORTS <= set(runtime.exports), "required export set is incomplete")
+    require(runtime.constant("lexeditor_issue_51_hook_count") == HOOK_COUNT,
+            "hook-count export is not exactly 28")
+    require(runtime.constant(
+        "lexeditor_issue_51_compile_gate_enabled", boolean=True,
+    ) == 1, "compile-gate export is not one")
+    require(runtime.constant(
+        "lexeditor_issue_51_core_linked", boolean=True,
+    ) == 1, "core-linked export is not one")
+    require(runtime.constant("lexeditor_issue_51_config_version") == 1,
+            "config-version export is not one")
+    require(runtime.constant(
+        "lexeditor_ff8_shared_magic_compiled_hook_count") == 28,
+        "compiled function-hook count is not 28")
+    require(runtime.constant(
+        "lexeditor_ff8_shared_magic_compiled_call_site_count") == 4,
+        "compiled call-site count is not four")
+    require(runtime.constant(
+        "lexeditor_ff8_shared_magic_compiled_patch_site_count") == 32,
+        "compiled total patch-site count is not 32")
+    require(runtime.constant("lexeditor_issue_51_runtime_requested") is None,
+            "runtime-requested export is forged as a constant")
+    require(runtime.returned_string("lexeditor_issue_51_identity") == IDENTITY,
+            "identity export does not return the exact runtime-on identity")
+    require(runtime.returned_string("lexeditor_issue_51_config_contract") ==
+            CONFIG_IDENTITY,
+            "config export does not return the exact config identity")
+    return runtime
+
+
+def mutation_test(path: Path, runtime: LinkedRuntime) -> int:
+    mutations: list[tuple[str, int, bytes]] = []
+    for value in (27, 29):
+        offset = runtime.function_offset("lexeditor_issue_51_hook_count")
+        mutations.append((f"hook-{value}", offset + 1, struct.pack("<I", value)))
+    for name in ("lexeditor_issue_51_compile_gate_enabled",
+                 "lexeditor_issue_51_core_linked",
+                 "lexeditor_issue_51_config_version",
+                 "lexeditor_ff8_shared_magic_compiled_hook_count",
+                 "lexeditor_ff8_shared_magic_compiled_call_site_count",
+                 "lexeditor_ff8_shared_magic_compiled_patch_site_count"):
+        offset = runtime.function_offset(name)
+        mutations.append((name, offset, b"\x33\xC0\xC3"))
+    for name in ("lexeditor_issue_51_identity",
+                 "lexeditor_issue_51_config_contract"):
+        address = runtime.constant(name)
+        require(address is not None, f"cannot mutate pointer export: {name}")
+        offset = runtime.file_offset(address - runtime.image_base)
+        mutations.append((name, offset, b"X"))
+    offset = runtime.function_offset("lexeditor_issue_51_runtime_requested")
+    mutations.append(("requested-false", offset, b"\x33\xC0\xC3"))
+
+    rejected = 0
+    with tempfile.TemporaryDirectory(prefix="issue51-linked-runtime-") as temp:
+        for label, offset, replacement in mutations:
+            target = Path(temp) / f"{label}.dll"
+            shutil.copyfile(path, target)
+            data = bytearray(target.read_bytes())
+            data[offset:offset + len(replacement)] = replacement
+            target.write_bytes(data)
+            try:
+                verify(target)
+            except (AssertionError, UnicodeError, ValueError, pefile.PEFormatError):
+                rejected += 1
+    require(rejected == len(mutations),
+            f"linked-runtime mutation coverage incomplete: {rejected}/{len(mutations)}")
+    return rejected
+
+
+def main() -> int:
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: verify_issue51_runtime_artifact.py <FFNx.dll>")
+    path = Path(sys.argv[1]).resolve()
+    runtime = verify(path)
+    rejected = mutation_test(path, runtime)
+    print(
+        "issue #51 linked runtime: PASS "
+        f"(hooks={HOOK_COUNT}; {rejected} binary mutations rejected)"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
