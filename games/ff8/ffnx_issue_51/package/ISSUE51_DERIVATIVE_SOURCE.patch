+bool executable_hash_matches()
+{
+    char filename[MAX_PATH]{};
+    if (GetModuleFileNameA(nullptr, filename, MAX_PATH) == 0) {
+        return false;
+    }
+    try {
+        std::string digest;
+        CryptoPP::SHA256 hash;
+        CryptoPP::FileSource source(filename, true,
+            new CryptoPP::HashFilter(hash,
+                new CryptoPP::HexEncoder(new CryptoPP::StringSink(digest), false)));
+        return digest == kSupportedExeSha256;
+    } catch (...) {
+        return false;
+    }
+}
