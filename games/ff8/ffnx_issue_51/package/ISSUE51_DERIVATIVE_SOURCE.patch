+void write_relative(std::uint8_t *instruction, const std::uint8_t opcode,
+                    const void *target)
+{
+    instruction[0] = opcode;
+    const auto next = reinterpret_cast<std::intptr_t>(instruction + 5);
+    const auto destination = reinterpret_cast<std::intptr_t>(target);
+    *reinterpret_cast<std::int32_t *>(instruction + 1) =
+        static_cast<std::int32_t>(destination - next);
+}
