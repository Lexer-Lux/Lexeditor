+    0x71,0x20,0x6B,0x6D,0x70,0x63,0x20,0x72,0x66,0x5F,0x6C,0x20,0x22,0x21,0x21,0x20,
+    0x61,0x6D,0x6E,0x67,0x63,0x71,0x20,0x6D,0x64,0x20,0x6D,0x6C,0x63,0x20,0x71,0x6E,
+    0x63,0x6A,0x6A,0x3B,0x20,0x52,0x6D,0x20,0x51,0x5F,0x65,0x67,0x61,0x20,0x75,0x5F,
+    0x71,0x20,0x61,0x66,0x5F,0x6C,0x65,0x63,0x62,0x3B,0x00
+};
+
+struct NativeTextTable {
+    std::uint16_t count = 1;
+    std::uint16_t offset = 4;
+    std::array<std::uint8_t, kOverstockText.size()> text{};
+};
+
+static_assert(offsetof(NativeTextTable, text) == 4,
+              "native text table offset changed");
+static_assert(kInvalidSlotText.back() == 0 && kDistinctText.back() == 0 &&
+              kOverstockText.back() == 0,
+              "native warning text must have one terminating NUL");
+
+NativeTextTable g_native_text{};
+constexpr std::array<std::uint16_t, 9> kWarningScript = {
+    0x6014, 0x7064, 0x5000, 0x3000, 0x2000,
+    0x8000, 0x4000, 0xA000, 0xF000,
+};
+
+PrivateInventories read_saved()
+{
+    PrivateInventories result{};
+    for (std::size_t character = 0; character < kCharacterCount; ++character) {
+        std::memcpy(result[character].data(),
+                    ff8_externals.savemap->chars[character].magics,
+                    sizeof(MagicInventory));
+    }
+    return result;
+}
+
+void write_saved(const PrivateInventories &source)
+{
+    for (std::size_t character = 0; character < kCharacterCount; ++character) {
+        std::memcpy(ff8_externals.savemap->chars[character].magics,
+                    source[character].data(), sizeof(MagicInventory));
+    }
+}
+
+void fail_closed_to_canonical(const char *reason)
+{
+    const bool fallback_written =
+        g_canonical_snapshot_valid && ff8_externals.savemap != nullptr;
+    if (fallback_written) {
+        PrivateInventories fallback{};
+        fallback[0] = g_state.canonical_snapshot;
+        write_saved(fallback);
+    }
+    g_actor_ready.fill(false);
+    g_private_transaction_depth = 0;
+    g_private_transaction_snapshot = {};
+    g_private_character_snapshot = {};
+    g_reconciliation_owner_depth = 0;
+    g_state.shared_pool_active = false;
+    g_state.phase = RuntimePhase::private_stocks;
+    g_canonical_snapshot_valid = false;
+    if (g_first_failure.empty()) {
+        g_first_failure = reason;
+    }
+    char line[512]{};
+    std::snprintf(line, sizeof(line), "failure reason=%s fallback=%s\n", reason,
+                  fallback_written ? "written" : "not-owned");
+    append_runtime_log(line);
+    ffnx_error("Shared Magic: fail-closed canonical fallback: %s.\n", reason);
+}
+
+MagicInventory read_actor(const std::size_t actor)
+{
+    MagicInventory result{};
+    const std::uint8_t *base = ff8_externals.shared_magic_battle_actor_base
+        + actor * kActorStride + kActorMagicOffset;
+    for (std::size_t slot = 0; slot < kSlotCount; ++slot) {
+        result[slot] = {base[slot * kActorMagicStride],
+                        base[slot * kActorMagicStride + 1]};
+    }
+    return result;
+}
+
+ActorInventories read_actors()
+{
+    ActorInventories result{};
+    if (getmode_cached()->driver_mode != MODE_BATTLE) {
+        return result;
+    }
+    for (std::size_t actor = 0; actor < kActorCount; ++actor) {
+        if (g_actor_ready[actor]) {
+            result[actor] = read_actor(actor);
+        }
+    }
+    return result;
+}
+
+void write_actor(const std::size_t actor, const MagicInventory &inventory)
+{
+    std::uint8_t *base = ff8_externals.shared_magic_battle_actor_base
+        + actor * kActorStride + kActorMagicOffset;
+    for (std::size_t slot = 0; slot < kSlotCount; ++slot) {
+        base[slot * kActorMagicStride] = inventory[slot].id;
+        base[slot * kActorMagicStride + 1] = inventory[slot].amount;
+    }
+}
+
+void mirror_actors()
+{
+    if (getmode_cached()->driver_mode != MODE_BATTLE) {
+        return;
+    }
+    ++g_internal_depth;
+    auto refresh = reinterpret_cast<void (__cdecl *)(int)>(
+        ff8_externals.shared_magic_actor_refresh);
+    for (std::size_t actor = 0; actor < kActorCount; ++actor) {
+        if (!g_actor_ready[actor]) {
+            continue;
+        }
+        write_actor(actor, g_state.canonical_snapshot);
+        refresh(static_cast<int>(actor));
+    }
+    --g_internal_depth;
+}
+
+void preserve_canonical()
+{
+    if (!g_state.shared_pool_active ||
+        g_state.phase != RuntimePhase::shared_mirror) {
+        return;
+    }
+    PrivateInventories current = read_saved();
+    if (!restore_canonical_mirror(g_state, current)) {
+        fail_closed_to_canonical("mirror restore invariant failed");
+        return;
+    }
+    write_saved(current);
+    mirror_actors();
+}
+
+void adopt_saved_change()
+{
+    if (!g_state.shared_pool_active ||
+        g_state.phase != RuntimePhase::shared_mirror ||
+        g_private_transaction_depth != 0) {
+        return;
+    }
+    PrivateInventories current = read_saved();
+    std::size_t changed_count = 0;
+    MagicInventory changed_result{};
+    bool changed_results_match = true;
+    for (std::size_t character = 0; character < kCharacterCount; ++character) {
+        if (current[character] != g_state.canonical_snapshot) {
+            if (changed_count == 0) {
+                changed_result = current[character];
+            } else {
+                changed_results_match = changed_results_match &&
+                    current[character] == changed_result;
+            }
+            ++changed_count;
+        }
+    }
+    if (changed_count == 0) {
+        preserve_canonical();
+        return;
+    }
+    ++g_reconcile_attempts;
+    if (!changed_results_match ||
+        !reconcile_from_inventory(g_state, current, changed_result)) {
+        fail_closed_to_canonical("saved-stock transaction was ambiguous");
+        return;
+    }
+    ++g_reconcile_successes;
+    write_saved(current);
+    mirror_actors();
+}
+
+void adopt_actor_change(const ActorInventories &before)
+{
+    if (!g_state.shared_pool_active ||
+        g_state.phase != RuntimePhase::shared_mirror) {
+        return;
+    }
+    const ActorInventories after = read_actors();
+    std::size_t changed_count = 0;
+    MagicInventory changed_result{};
+    bool changed_results_match = true;
+    for (std::size_t actor = 0; actor < kActorCount; ++actor) {
+        if (!g_actor_ready[actor]) {
+            continue;
+        }
+        if (after[actor] != before[actor]) {
+            if (changed_count == 0) {
+                changed_result = after[actor];
+            } else {
+                changed_results_match = changed_results_match &&
+                    after[actor] == changed_result;
+            }
+            ++changed_count;
+        }
+    }
+    if (changed_count == 0) {
+        return;
+    }
+    PrivateInventories current = read_saved();
+    ++g_reconcile_attempts;
+    if (!changed_results_match ||
+        !reconcile_from_inventory(g_state, current, changed_result)) {
+        fail_closed_to_canonical("battle-stock transaction was ambiguous");
+        return;
+    }
+    ++g_reconcile_successes;
+    write_saved(current);
+    mirror_actors();
+}
+
+void request_activation()
+{
+    if (!g_requested || !ff8_externals.savemap) {
+        return;
+    }
+    ++g_activation_attempts;
+    PrivateInventories candidate = read_saved();
+    g_state = {};
+    g_state.stock_limit = g_stock_limit;
+    g_canonical_snapshot_valid = false;
+    g_actor_ready.fill(false);
+    g_private_transaction_depth = 0;
+    g_reconciliation_owner_depth = 0;
+    const ActivationResult result = activate_runtime(g_state, candidate);
+    if (!result.shared_pool_active) {
+        // Activation is part of FF8's save-load transaction. Never retain the
+        // main-menu controller to display a warning here: doing so can stall
+        // or recursively re-enter the loader. Preserve the private stocks,
+        // disable sharing for this process, and let the original loader run.
+        g_requested = false;
+        g_warning = MergeError::none;
+        g_warning_started = false;
+        g_warning_updating = false;
+        append_runtime_log(
+            "activation blocked: private Magic preserved; Shared Magic disabled for this session\n");
+        ffnx_warning(
+            "Shared Magic: lossless activation was blocked; private Magic was preserved and loading will continue.\n");
+        return;
+    }
+    g_canonical_snapshot_valid = true;
+    ++g_activation_successes;
+    write_saved(candidate);
+    g_warning = MergeError::none;
+    ffnx_info("Shared Magic: lossless shared pool activated.\n");
+}
+
+template<std::size_t N>
+void select_warning_text(const std::array<std::uint8_t, N> &text)
+{
+    g_native_text.text.fill(0);
+    std::copy(text.begin(), text.end(), g_native_text.text.begin());
+}
+
+void select_overstock_warning_text()
+{
+    constexpr std::size_t digits_begin = 60;
+    constexpr std::size_t digits_end = 63;
+    g_native_text.text.fill(0);
+    std::copy(kOverstockText.begin(), kOverstockText.begin() + digits_begin,
+              g_native_text.text.begin());
+
+    const auto digits = std::to_string(static_cast<unsigned int>(g_stock_limit));
+    auto output = g_native_text.text.begin() + digits_begin;
+    for (const char digit : digits) {
+        // FF8's menu alphabet stores ASCII digits fifteen code points lower.
+        *output++ = static_cast<std::uint8_t>(digit - 0x0F);
+    }
+    std::copy(kOverstockText.begin() + digits_end, kOverstockText.end(), output);
+}
+
+bool update_warning_modal()
+{
+    if (g_warning == MergeError::none) {
+        return false;
+    }
+    auto done = reinterpret_cast<int (__cdecl *)()>(
+        ff8_externals.shared_magic_dialog_done);
+    auto start = reinterpret_cast<void (__cdecl *)(const std::uint16_t *, const void *)>(
+        ff8_externals.shared_magic_dialog_start);
+    auto advance = reinterpret_cast<void (__cdecl *)()>(
+        ff8_externals.shared_magic_dialog_advance);
+    auto clear = reinterpret_cast<void (__cdecl *)()>(
+        ff8_externals.shared_magic_dialog_clear);
+
+    if (!g_warning_started) {
+        if (*ff8_externals.shared_magic_dialog_active != 0) {
+            return false;
+        }
+        switch (g_warning) {
+        case MergeError::invalid_slot: select_warning_text(kInvalidSlotText); break;
+        case MergeError::too_many_distinct_spells: select_warning_text(kDistinctText); break;
+        case MergeError::spell_stock_exceeds_limit: select_overstock_warning_text(); break;
+        default: select_warning_text(kInvalidSlotText); break;
+        }
+        // The interpreter reads base + u16(base + 2 + index * 2). Index zero
+        // therefore resolves to the encoded string at byte offset four.
+        start(kWarningScript.data(), &g_native_text);
+        g_warning_started = true;
+    } else if (!done()) {
+        advance();
+    } else {
+        // Drop ownership before calling into FF8. dialog_clear can synchronously
+        // re-enter the main-menu controller. Keeping the warning latched until
+        // after that call recursively clears the same dialog until FF8 exhausts
+        // its 1 MB thread stack.
+        g_warning = MergeError::none;
+        g_warning_started = false;
+        if (*ff8_externals.shared_magic_dialog_active != 0) {
+            clear();
+        }
+    }
+    return true;
+}
+
+bool is_private_transaction_hook(const HookId id)
+{
+    switch (id) {
+    case HookId::transfer_zero_cleanup:
+    case HookId::transfer_begin:
+    case HookId::transfer_compare:
+    case HookId::transfer_move:
+    case HookId::transfer_swap:
+    case HookId::transfer_finish:
+    case HookId::redistribution_copy:
+    case HookId::redistribution_sum:
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool is_reconciliation_owner(const HookId id)
+{
+    switch (id) {
+    case HookId::startup_initializer:
+    case HookId::script_initializer:
+    case HookId::stock_add:
+    case HookId::stock_remove:
+    case HookId::stock_add_core:
+    case HookId::stock_remove_core:
+    case HookId::character_swap:
+    case HookId::menu_controller:
+    case HookId::battle_list_controller:
+    case HookId::draw_transaction:
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool is_owned_nested_writer(const HookId id)
+{
+    switch (id) {
+    case HookId::field_add:
+    case HookId::actor_mutator:
+    case HookId::battle_to_save:
+    case HookId::actor_clear:
+    case HookId::actor_initialize:
+    case HookId::held_validator:
+    case HookId::stock_add:
+    case HookId::stock_remove:
+    case HookId::stock_add_core:
+    case HookId::stock_remove_core:
+    case HookId::character_swap:
+    case HookId::reorder:
+    case HookId::menu_controller:
+    case HookId::battle_list_controller:
+    case HookId::draw_transaction:
+        return true;
+    default:
+        return false;
+    }
+}
+
+void enter_private_transaction(HookFrame &frame)
+{
+    if (!g_state.shared_pool_active ||
+        g_state.phase != RuntimePhase::shared_mirror ||
+        !is_private_transaction_hook(frame.id)) {
+        return;
+    }
+    frame.private_transaction_member = true;
+    if (g_private_transaction_depth++ != 0) {
+        return;
+    }
+
+    g_private_transaction_snapshot = g_state.canonical_snapshot;
+    for (std::size_t character = 0; character < kCharacterCount; ++character) {
+        g_private_character_snapshot[character] =
+            ff8_externals.savemap->chars[character];
+    }
+    PrivateInventories private_stock{};
+    private_stock[0] = g_private_transaction_snapshot;
+    write_saved(private_stock);
+}
+
+void leave_private_transaction(const HookFrame &frame)
+{
+    if (!frame.private_transaction_member) {
+        return;
+    }
+    if (g_private_transaction_depth == 0) {
+        fail_closed_to_canonical("private transaction nesting underflow");
+        return;
+    }
+    if (--g_private_transaction_depth != 0) {
+        return;
+    }
+
+    g_state.canonical_snapshot = g_private_transaction_snapshot;
+    for (std::size_t character = 0; character < kCharacterCount; ++character) {
+        ff8_externals.savemap->chars[character] =
+            g_private_character_snapshot[character];
+    }
+    PrivateInventories restored{};
+    for (MagicInventory &inventory : restored) {
+        inventory = g_private_transaction_snapshot;
+    }
+    write_saved(restored);
+    mirror_actors();
+}
+
+void before_original(HookFrame &frame)
+{
+    frame.internal = g_internal_depth != 0;
+    if (frame.internal) {
+        return;
+    }
+    if (!g_state.shared_pool_active) {
+        return;
+    }
+    enter_private_transaction(frame);
+    if (frame.private_transaction_member) {
+        return;
+    }
+    if (g_private_transaction_depth != 0 ||
+        (g_reconciliation_owner_depth != 0 &&
+         is_owned_nested_writer(frame.id))) {
+        frame.nested_owned_writer = true;
+        return;
+    }
+    if (g_state.phase != RuntimePhase::shared_mirror &&
+        frame.id != HookId::scenario_exit) {
+        return;
+    }
+    if (is_reconciliation_owner(frame.id)) {
+        frame.reconciliation_owner = true;
+        ++g_reconciliation_owner_depth;
+    }
+    frame.saved_before = read_saved();
+    frame.actors_before = read_actors();
+
+    switch (frame.id) {
+    case HookId::battle_to_save:
+        if (g_state.shared_pool_active &&
+            g_state.phase == RuntimePhase::shared_mirror) {
+            for (std::size_t actor = 0; actor < kActorCount; ++actor) {
+                if (g_actor_ready[actor] &&
+                    frame.actors_before[actor] != g_state.canonical_snapshot) {
+                    ffnx_warning("Shared Magic: corrected a divergent battle mirror before teardown.\n");
+                    mirror_actors();
+                    break;
+                }
+            }
+        }
+        break;
+    case HookId::scenario_enter:
+        if (g_state.shared_pool_active &&
+            !suspend_for_private_scenario(g_state, frame.saved_before)) {
+            fail_closed_to_canonical("scenario suspension invariant failed");
+        }
+        g_actor_ready.fill(false);
+        break;
+    case HookId::battle_list_controller:
+        frame.battle_magic_callback =
+            *ff8_externals.shared_magic_battle_list_callback ==
+                ff8_externals.shared_magic_battle_magic_callback;
+        break;
+    case HookId::actor_clear:
+        if (frame.argument2 < kActorCount) {
+            g_actor_ready[frame.argument2] = false;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void after_original(const HookFrame &frame)
+{
+    if (frame.internal) {
+        return;
+    }
+    if (frame.private_transaction_member) {
+        leave_private_transaction(frame);
+        return;
+    }
+    if (frame.nested_owned_writer) {
+        return;
+    }
+
+    switch (frame.id) {
+    case HookId::field_add:
+    case HookId::stock_add:
+    case HookId::stock_remove:
+    case HookId::stock_add_core:
+    case HookId::stock_remove_core:
+    case HookId::held_validator:
+    case HookId::draw_transaction:
+    case HookId::reorder:
+        adopt_saved_change();
+        break;
+    case HookId::actor_mutator:
+        adopt_actor_change(frame.actors_before);
+        break;
+    case HookId::battle_list_controller:
+        if (frame.battle_magic_callback) {
+            adopt_actor_change(frame.actors_before);
+        }
+        break;
+    case HookId::actor_initialize:
+        {
+        const bool initial_battle_setup = frame.original_return ==
+            ff8_externals.shared_magic_initial_battle_actor_init_return;
+        const bool battle_rematerialization =
+            (frame.original_return ==
+                 ff8_externals.shared_magic_rebuild_actor_init_return ||
+             frame.original_return ==
+                 ff8_externals.shared_magic_party_actor_init_return) &&
+            getmode_cached()->driver_mode == MODE_BATTLE;
+        if (g_state.shared_pool_active &&
+            g_state.phase == RuntimePhase::shared_mirror &&
+            frame.argument1 != 0xFF && frame.argument2 < kActorCount &&
+            frame.original_return !=
+                ff8_externals.shared_magic_post_commit_actor_init_return &&
+            (initial_battle_setup || battle_rematerialization)) {
+            g_actor_ready[frame.argument2] = true;
+            ++g_internal_depth;
+            write_actor(frame.argument2, g_state.canonical_snapshot);
+            auto refresh = reinterpret_cast<void (__cdecl *)(int)>(
+                ff8_externals.shared_magic_actor_refresh);
+            refresh(static_cast<int>(frame.argument2));
+            --g_internal_depth;
+        }
+        break;
+        }
+    case HookId::actor_clear:
+        break;
+    case HookId::scenario_exit:
+        if (g_state.shared_pool_active &&
+            g_state.phase == RuntimePhase::scenario_private) {
+            PrivateInventories restored = read_saved();
+            bool exact_restore = true;
+            for (const MagicInventory &inventory : restored) {
+                exact_restore = exact_restore &&
+                    inventory == g_state.canonical_snapshot;
+            }
+            if (!exact_restore ||
+                !resume_after_private_scenario(g_state, restored)) {
+                fail_closed_to_canonical("scenario restore verification failed");
+            } else {
+                write_saved(restored);
+                mirror_actors();
+            }
+        }
+        break;
+    case HookId::startup_initializer:
+    case HookId::script_initializer:
+    case HookId::battle_to_save:
+        preserve_canonical();
+        g_actor_ready.fill(false);
+        break;
+    case HookId::character_swap:
+        preserve_canonical();
+        break;
+    case HookId::menu_controller:
+        adopt_saved_change();
+        break;
+    case HookId::transfer_begin:
+    case HookId::transfer_compare:
+    case HookId::transfer_move:
+    case HookId::transfer_swap:
+    case HookId::transfer_finish:
+    case HookId::transfer_zero_cleanup:
+    case HookId::redistribution_copy:
+    case HookId::redistribution_sum:
+        leave_private_transaction(frame);
+        break;
+    case HookId::main_menu_controller:
+    case HookId::scenario_enter:
+    case HookId::count:
+        break;
+    }
+
+    if (frame.reconciliation_owner) {
+        if (g_reconciliation_owner_depth == 0) {
+            fail_closed_to_canonical("reconciliation owner nesting underflow");
+        } else {
+            --g_reconciliation_owner_depth;
+        }
+    }
+}
+
+extern "C" void __declspec(noinline) __cdecl issue51_before(
+    std::uintptr_t *return_slot, std::uint32_t raw_id);
+extern "C" std::uintptr_t __declspec(noinline) __cdecl issue51_after();
+extern "C" int __declspec(noinline) __cdecl issue51_should_bypass(
+    std::uint32_t raw_id);
+
+extern "C" int __declspec(noinline) __cdecl issue51_should_bypass(
+    const std::uint32_t raw_id)
+{
+    if (raw_id < g_function_hits.size()) {
+        ++g_function_hits[raw_id];
+        ++g_function_hit_total;
+    }
+    const HookId id = static_cast<HookId>(raw_id);
+    if (id == HookId::main_menu_controller &&
+        g_warning != MergeError::none) {
+        // FF8's dialog advance and clear functions synchronously re-enter the
+        // main-menu controller. Retain that nested controller call without
+        // advancing the same warning again.
+        if (g_warning_updating) {
+            return 1;
+        }
+        g_warning_updating = true;
+        const int result = update_warning_modal();
+        g_warning_updating = false;
+        return result;
+    }
+    return g_state.shared_pool_active &&
+           g_state.phase == RuntimePhase::shared_mirror &&
+           is_private_transaction_hook(id);
+}
+
+extern "C" void __declspec(naked) issue51_post_thunk()
+{
+    __asm {
+        sub esp, 4
+        pushfd
+        pushad
+        call issue51_after
+        mov [esp + 36], eax
+        popad
+        popfd
+        ret
+    }
+}
+
+extern "C" void __declspec(noinline) __cdecl issue51_before(
+    std::uintptr_t *return_slot, const std::uint32_t raw_id)
+{
+    if (g_frame_depth >= g_frames.size()) {
+        fail_closed_to_canonical("hook nesting limit reached");
+        return;
+    }
+    HookFrame &frame = g_frames[g_frame_depth++];
+    frame = {};
+    frame.id = static_cast<HookId>(raw_id);
+    frame.original_return = *return_slot;
+    frame.argument1 = static_cast<std::uint32_t>(return_slot[1]);
+    frame.argument2 = static_cast<std::uint32_t>(return_slot[2]);
+    before_original(frame);
+    *return_slot = reinterpret_cast<std::uintptr_t>(&issue51_post_thunk);
