+bool lexeditor_ff8_hide_startup_frame()
+{
+    static bool finished = false;
+    if (!ff8 || !enable_ff8_fast_start || finished) return false;
+    VOBJ(game_obj, game_object, common_externals.get_game_object());
+    const auto loop = reinterpret_cast<uintptr_t>(VREF(game_object, game_loop_obj).main_loop);
+    if (loop == ff8_externals.main_menu_main_loop) {
+        finished = true;
+        return false;
+    }
+    const bool startup = loop == ff8_externals.pubintro_main_loop ||
+        loop == ff8_externals.credits_main_loop ||
+        loop == ff8_externals.go_to_main_menu_main_loop;
+    // An alternate direct-to-game launch also ends the one-time startup gate.
+    const auto *mode = getmode_cached();
+    if (!startup && mode != nullptr && (mode->driver_mode == MODE_FIELD ||
+        mode->driver_mode == MODE_WORLDMAP || mode->driver_mode == MODE_BATTLE ||
+        mode->driver_mode == MODE_MENU)) finished = true;
+    return startup;
+}
