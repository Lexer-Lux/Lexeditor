# Generated reports and dumps
out/
logs/
.venv/
$out/
artifacts/
/FFNx.log
# One flat <issue>.md per issue; no subfolders, mirrors or attachments.
worklog/*/
*.tsv
*_features.txt

__pycache__/
*.pyc
*.obj
*.bak
.pytest_cache/
node_modules/

# Reproducible tool build outputs; keep the packaged runtime under tools/rpf-cli/bin.
tools/rpf-cli/build/
tools/rpf-cli/source/RpfCli/bin/
tools/rpf-cli/source/RpfCli/obj/
tools/magic-rdr/MagicRDR_*.zip

# Downloaded or private RDR2 fonts. Source and release bundles do not include
# these binaries.
plugins/rdr2/assets/fonts/*.ttf
plugins/rdr2/assets/fonts/*.otf
plugins/rdr2/assets/fonts/*.woff
plugins/rdr2/assets/fonts/*.woff2
!plugins/rdr2/assets/fonts/README.md

# Fonts the RDR plugin fetches or extracts at run time; never redistributed.
plugins/rdr/assets/fonts/*.woff
plugins/rdr/assets/fonts/*.woff2
